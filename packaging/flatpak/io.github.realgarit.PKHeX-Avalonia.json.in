{
  "app-id": "io.github.realgarit.PKHeX-Avalonia",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.dotnet10"],
  "command": "PKHeX.Avalonia",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--share=network",
    "--env=DOTNET_ROOT=/app/lib/dotnet"
  ],
  "build-options": {
    "prepend-path": "/usr/lib/sdk/dotnet10/bin",
    "append-ld-library-path": "/usr/lib/sdk/dotnet10/lib",
    "env": {
      "DOTNET_CLI_TELEMETRY_OPTOUT": "true",
      "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "true",
      "NUGET_PACKAGES": "/run/build/pkhex-avalonia/nuget-cache"
    }
  },
  "modules": [
    {
      "name": "dotnet",
      "buildsystem": "simple",
      "build-commands": ["/usr/lib/sdk/dotnet10/bin/install.sh"]
    },
    {
      "name": "pkhex-avalonia",
      "buildsystem": "simple",
      "build-commands": [
        "dotnet publish PKHeX.Avalonia/PKHeX.Avalonia.csproj -c Release -r linux-x64 --no-self-contained -p:PublishSingleFile=false -p:NuGetAudit=false --source ./nuget-sources --source /usr/lib/sdk/dotnet10/nuget/packages -o /app/lib/pkhex-avalonia",
        "bash packaging/flatpak/install-assets.sh @VERSION@ @SOURCE_REVISION@ @RELEASE_DATE@"
      ],
      "sources": [
        {
          "type": "archive",
          "path": "source.tar",
          "sha256": "@SOURCE_SHA256@",
          "strip-components": 0
        },
        "nuget-sources.json"
      ]
    }
  ]
}
