app-id: io.github.realgarit.PKHeX-Avalonia
runtime: org.freedesktop.Platform
runtime-version: '26.08'
sdk: org.freedesktop.Sdk
sdk-extensions:
- org.freedesktop.Sdk.Extension.dotnet10
command: PKHeX.Avalonia
finish-args:
- --share=ipc
- --socket=x11
- --device=dri
- --share=network
- --env=DOTNET_ROOT=/app/lib/dotnet
build-options:
  prepend-path: /usr/lib/sdk/dotnet10/bin
  append-ld-library-path: /usr/lib/sdk/dotnet10/lib
  env:
    DOTNET_CLI_TELEMETRY_OPTOUT: 'true'
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE: 'true'
    NUGET_PACKAGES: /run/build/pkhex-avalonia/nuget-cache
  arch:
    aarch64:
      env:
        RUNTIME: linux-arm64
    x86_64:
      env:
        RUNTIME: linux-x64
modules:
- name: dotnet
  buildsystem: simple
  build-commands:
  - /usr/lib/sdk/dotnet10/bin/install.sh
  - install -Dm644 /usr/lib/sdk/dotnet10/share/licenses/org.freedesktop.Sdk.Extension.dotnet10/dotnet-sdk/LICENSE.txt
    /app/share/licenses/io.github.realgarit.PKHeX-Avalonia/dotnet/LICENSE.txt
- name: pkhex-avalonia
  buildsystem: simple
  build-commands:
  - |-
    dotnet publish PKHeX.Avalonia/PKHeX.Avalonia.csproj \
      -c Release -r $RUNTIME --no-self-contained \
      -p:PublishSingleFile=false -p:NuGetAudit=false \
      -p:SourceRevisionId=@SOURCE_REVISION@ \
      --source ./nuget-sources \
      --source /usr/lib/sdk/dotnet10/nuget/packages \
      -o /app/lib/pkhex-avalonia
  - sed -i '/^appstreamcli validate --no-net /d' packaging/flatpak/install-assets.sh
  - bash packaging/flatpak/install-assets.sh @VERSION@ @SOURCE_REVISION@ @RELEASE_DATE@
  sources:
  - type: archive
    url: https://github.com/realgarit/PKHeX-Avalonia/archive/refs/tags/v@VERSION@.tar.gz
    sha256: @SOURCE_SHA256@
    strip-components: 1
  - nuget-sources.json
