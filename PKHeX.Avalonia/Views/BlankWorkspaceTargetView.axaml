<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation"
             xmlns:loc="using:PKHeX.Avalonia.Localization"
             x:Class="PKHeX.Avalonia.Views.BlankWorkspaceTargetView"
             x:DataType="vm:BlankWorkspaceTargetViewModel"
             Width="440" Height="520" MinWidth="360" MinHeight="360">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </UserControl.KeyBindings>
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <TextBlock Text="{loc:Loc BlankWorkspace_Description}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="{Binding Context}" IsVisible="{Binding HasContext}"
                   TextWrapping="Wrap" FontWeight="SemiBold" />
        <ListBox x:Name="TargetList" Grid.Row="2" ItemsSource="{Binding Targets}"
                 SelectedItem="{Binding SelectedTarget}"
                 AutomationProperties.Name="{loc:Loc BlankWorkspace_TargetList}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:BlankWorkspaceTargetOption">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
            <Button Classes="accent" Content="{loc:Loc BlankWorkspace_Confirm}" Command="{Binding ConfirmCommand}" IsDefault="True" />
        </StackPanel>
    </Grid>
</UserControl>
