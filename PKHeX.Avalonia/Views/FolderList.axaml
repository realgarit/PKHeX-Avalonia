<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation"
             xmlns:loc="using:PKHeX.Avalonia.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PKHeX.Avalonia.Views.FolderList"
             x:DataType="vm:FolderListViewModel">

    <Border Classes="view-container">
    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Header / Filter -->
        <Border Grid.Row="0" Classes="tool-header">
        <DockPanel>
            <TextBlock Text="{loc:Loc FolderList_Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <TextBox Text="{Binding FilterText}" Watermark="{loc:Loc FolderList_FilterWatermark}" Width="200"
                         AutomationProperties.Name="{loc:Loc FolderList_FilterWatermark}"/>
                <Button Content="{loc:Loc FolderList_Refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" />
                <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsLoading}" />
                <Button Content="{loc:Loc Common_Close}" Command="{Binding CloseCommand}" />
            </StackPanel>
        </DockPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Classes="editor-tabs">
            <TabItem Classes="editor-tab" Header="{loc:Loc FolderList_RecentFiles}">
                    <DataGrid Classes="save-grid" ItemsSource="{Binding FilteredRecentSaves}"
                          SelectedItem="{Binding SelectedRecentSave}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc FolderList_FileName}" Binding="{Binding FileName}" Width="200"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_Version}" Binding="{Binding Version}" Width="90"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_Trainer}" Binding="{Binding TrainerName}" Width="100"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_PlayTime}" Binding="{Binding PlayTime}" Width="100"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_Badges}" Binding="{Binding BadgeCount}" Width="80"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_LastModified}" Binding="{Binding LastModified}" Width="150"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_Path}" Binding="{Binding FilePath}" Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc FolderList_Open}" Command="{Binding OpenSaveCommand}" CommandParameter="{Binding SelectedRecentSave}"/>
                            <MenuItem Header="{loc:Loc FolderList_OpenFolder}" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedRecentSave}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>
            <TabItem Classes="editor-tab" Header="{loc:Loc FolderList_Backups}">
                  <DataGrid Classes="save-grid" ItemsSource="{Binding FilteredBackupSaves}"
                          SelectedItem="{Binding SelectedBackupSave}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc FolderList_FileName}" Binding="{Binding FileName}" Width="200"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_Version}" Binding="{Binding Version}" Width="90"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_Trainer}" Binding="{Binding TrainerName}" Width="100"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_PlayTime}" Binding="{Binding PlayTime}" Width="100"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_Badges}" Binding="{Binding BadgeCount}" Width="80"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_LastModified}" Binding="{Binding LastModified}" Width="150"/>
                        <DataGridTextColumn Header="{loc:Loc FolderList_Path}" Binding="{Binding FilePath}" Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc FolderList_Open}" Command="{Binding OpenSaveCommand}" CommandParameter="{Binding SelectedBackupSave}"/>
                            <MenuItem Header="{loc:Loc FolderList_OpenFolder}" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedBackupSave}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>
        </TabControl>
        
        <!-- Status Bar -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="0,8,0,0"/>
        
        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" Classes="overlay-scrim" IsVisible="{Binding IsLoading}">
            <TextBlock Classes="overlay-text" Text="{loc:Loc FolderList_Loading}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
        </Border>
    </Grid>
    </Border>
</UserControl>
