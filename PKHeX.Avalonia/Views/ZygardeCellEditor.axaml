<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation"
             xmlns:loc="using:PKHeX.Avalonia.Localization"
             x:Class="PKHeX.Avalonia.Views.ZygardeCellEditor"
             x:DataType="vm:ZygardeCellEditorViewModel">

    <Border Classes="view-container">
        <Panel>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !IsSupported}">
                <TextBlock Text="{loc:Loc ZygardeCellEditor_NotAvailable}" FontSize="18" HorizontalAlignment="Center" Opacity="0.7" />
                <TextBlock Text="{loc:Loc ZygardeCellEditor_NotAvailableDesc}" HorizontalAlignment="Center" Opacity="0.5" Margin="0,8,0,0" />
            </StackPanel>

            <DockPanel IsVisible="{Binding IsSupported}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="{loc:Loc ZygardeCellEditor_Title}" IsVisible="{Binding !IsTotemSticker}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc ZygardeCellEditor_TotemStickerTitle}" IsVisible="{Binding IsTotemSticker}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{loc:Loc ZygardeCellEditor_CollectAll}" IsVisible="{Binding !IsTotemSticker}" Command="{Binding CollectAllCommand}" Padding="12,6" />
                        <Button Content="{loc:Loc ZygardeCellEditor_CollectAllStickers}" IsVisible="{Binding IsTotemSticker}" Command="{Binding CollectAllCommand}" Padding="12,6" />
                        <Button Content="{loc:Loc ZygardeCellEditor_Refresh}" Command="{Binding RefreshCommand}" Padding="12,6" />
                    </StackPanel>
                </DockPanel>

                <!-- Totals -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{loc:Loc ZygardeCellEditor_CellsTotal}" IsVisible="{Binding !IsTotemSticker}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc ZygardeCellEditor_StickersTotal}" IsVisible="{Binding IsTotemSticker}" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding CellsTotal}" Minimum="0" Maximum="999" Width="100" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{loc:Loc ZygardeCellEditor_CellsCollected}" IsVisible="{Binding !IsTotemSticker}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc ZygardeCellEditor_StickersCollected}" IsVisible="{Binding IsTotemSticker}" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding CellsCollected}" Minimum="0" Maximum="999" Width="100" />
                    </StackPanel>
                </StackPanel>

                <!-- Cell List -->
                <Border Classes="editor-section-padded" Padding="8">
                    <ListBox ItemsSource="{Binding Cells}" MaxHeight="400">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:ZygardeCellViewModel">
                                <Grid ColumnDefinitions="50,*,120" Margin="4">
                                    <TextBlock Text="{Binding Index, StringFormat='#{0}'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Location}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" />
                                    <ComboBox Grid.Column="2" SelectedIndex="{Binding State}" Width="110" IsVisible="{Binding $parent[UserControl].((vm:ZygardeCellEditorViewModel)DataContext).IsTotemSticker}" AutomationProperties.Name="Status">
                                        <ComboBoxItem Content="{loc:Loc ZygardeCellEditor_TotemStickerNone}" />
                                        <ComboBoxItem Content="{loc:Loc ZygardeCellEditor_TotemStickerAvailable}" />
                                        <ComboBoxItem Content="{loc:Loc ZygardeCellEditor_TotemStickerReceived}" />
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" SelectedIndex="{Binding State}" Width="110" IsVisible="{Binding $parent[UserControl].((vm:ZygardeCellEditorViewModel)DataContext).IsZygardeCell}" AutomationProperties.Name="Status">
                                        <ComboBoxItem Content="{loc:Loc ZygardeCellEditor_None}" />
                                        <ComboBoxItem Content="{loc:Loc ZygardeCellEditor_Available}" />
                                        <ComboBoxItem Content="{loc:Loc ZygardeCellEditor_Received}" />
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Panel>
    </Border>
</UserControl>
