<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation"
             xmlns:event="clr-namespace:PKHeX.Application.Models.Events;assembly=PKHeX.Application"
             xmlns:loc="using:PKHeX.Avalonia.Localization"
             x:Class="PKHeX.Avalonia.Views.CategorizedEventEditor"
             x:DataType="vm:CategorizedEventEditorViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </UserControl.KeyBindings>
    <Border Classes="view-container">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <TextBlock Text="{loc:Loc Events_Title}" Classes="view-title" Margin="0,0,12,0" />
                <ScrollViewer x:Name="EventWarningScroll" Grid.Column="1" MaxHeight="40"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Focusable="True" AutomationProperties.Name="{loc:Loc Events_Warning}">
                    <TextBlock Text="{loc:Loc Events_Warning}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc EventFlagsEditor_Reset}" Command="{Binding ResetCommand}" />
                    <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
                    <Button Content="{loc:Loc EventFlagsEditor_Apply}" Command="{Binding ApplyCommand}" Classes="compact-primary" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" Margin="0,0,8,0" />
            </DockPanel>
            <TabControl Classes="compact-editor-tabs">
                <TabItem Header="{loc:Loc Events_Edit}">
                    <Grid Margin="0,4,0,0"
                          TextElement.FontSize="{Binding $parent[UserControl].FontSize}"
                          TextElement.FontWeight="{Binding $parent[UserControl].FontWeight}"
                          TextElement.Foreground="{Binding $parent[UserControl].Foreground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" MinHeight="80" />
                            <RowDefinition Height="*" MinHeight="64" MaxHeight="120" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="EditorFilters" Grid.Row="0" Spacing="4" Margin="0,0,0,4">
                            <WrapPanel>
                                <ComboBox ItemsSource="{Binding Banks}" SelectedItem="{Binding SelectedBank}"
                                          AutomationProperties.Name="{loc:Loc Events_Bank}" Width="160" Margin="0,0,8,6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="vm:EventBankOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                          AutomationProperties.Name="{loc:Loc Events_Category}" Width="190" Margin="0,0,8,6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="vm:EventCategoryOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                    <TextBlock Text="{loc:Loc Events_Index}" VerticalAlignment="Center" />
                                    <NumericUpDown Value="{Binding SelectedIndex}" Minimum="0" Maximum="{Binding MaxIndex}" Width="140"
                                                   FormatString="0" AutomationProperties.Name="{loc:Loc Events_Index}" />
                                </StackPanel>
                            </WrapPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding SearchText}" PlaceholderText="{loc:Loc Events_Search}" AutomationProperties.Name="{loc:Loc Events_Search}" />
                                <TextBlock Grid.Column="1" Text="{Binding ScopeText}" Classes="muted" MaxWidth="280"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                        <ContentControl x:Name="EditorDetails" Grid.Row="2" Content="{Binding SelectedRow}" Margin="0,6,0,0">
                            <ContentControl.ContentTemplate>
                                <DataTemplate DataType="vm:EventDataRow">
                                    <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <WrapPanel>
                                                <CheckBox Content="{loc:Loc EventFlagsEditor_SetCheckbox}" IsChecked="{Binding IsSet}" IsVisible="{Binding IsBoolean}"
                                                          AutomationProperties.Name="{Binding Name}" />
                                                <TextBox Text="{Binding ValueText}" IsVisible="{Binding !IsBoolean}" IsEnabled="{Binding !EditAsFloat}"
                                                         Width="190" Margin="0,0,8,4" AutomationProperties.Name="{Binding Name}"
                                                         AutomationProperties.HelpText="{Binding BoundsText}" ToolTip.Tip="{Binding BoundsText}" />
                                                <TextBox Text="{Binding FloatText}" IsVisible="{Binding EditAsFloat}" Width="140" Margin="0,0,8,4"
                                                         AutomationProperties.Name="{loc:Loc Events_Float}" AutomationProperties.HelpText="{Binding Name}" />
                                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedPreset}" Width="200" Margin="0,0,8,4"
                                                          IsVisible="{Binding HasOptions}" PlaceholderText="{loc:Loc Events_Presets}" AutomationProperties.Name="{loc:Loc Events_Presets}"
                                                          ToolTip.Tip="{loc:Loc Events_Presets}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate DataType="event:EventDataOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <CheckBox Content="{loc:Loc Events_Float}" IsChecked="{Binding EditAsFloat}" IsVisible="{Binding SupportsFloat}"
                                                          ToolTip.Tip="{loc:Loc Events_FloatHelp}" Margin="0,0,0,4" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding BoundsText}" IsVisible="{Binding !IsBoolean}" TextWrapping="Wrap" Classes="muted" />
                                            <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasErrors}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <DataGrid Grid.Row="1" x:Name="EventGrid" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                                  AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal" ClipToBounds="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Events_Index}" Binding="{Binding Index}" Width="90" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="{loc:Loc Events_Name}" Width="*" MinWidth="140" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:EventDataRow">
                                            <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Loc Events_Category}" Width="160" SortMemberPath="Category">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:EventDataRow">
                                            <TextBlock Text="{Binding Category}" ToolTip.Tip="{Binding Category}" AutomationProperties.Name="{Binding Category}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Loc EventWorkEditor_WorkValueLabel}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:EventDataRow">
                                            <Panel>
                                                <CheckBox IsChecked="{Binding IsSet}" IsVisible="{Binding IsBoolean}"
                                                          AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding HexIndex}" />
                                                <TextBlock Text="{Binding DisplayValue}" ToolTip.Tip="{Binding DisplayValue}" IsVisible="{Binding !IsBoolean}" VerticalAlignment="Center" />
                                            </Panel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="{loc:Loc Events_Research}">
                    <DockPanel Margin="0,8,0,0"
                               TextElement.FontSize="{Binding $parent[UserControl].FontSize}"
                               TextElement.FontWeight="{Binding $parent[UserControl].FontWeight}"
                               TextElement.Foreground="{Binding $parent[UserControl].Foreground}">
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Events_ResearchHelp}" TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button Content="{loc:Loc Events_Compare}" Command="{Binding CompareCommand}" Margin="0,0,8,0" />
                                <Button Content="{loc:Loc Events_ClearResearch}" Command="{Binding ClearResearchCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        <DataGrid x:Name="DifferenceGrid" ItemsSource="{Binding Differences}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Events_Bank}" Binding="{Binding Kind}" Width="120" />
                                <DataGridTextColumn Header="{loc:Loc Events_Index}" Binding="{Binding Index}" Width="90" />
                                <DataGridTextColumn Header="{loc:Loc Events_Name}" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{loc:Loc Events_Before}" Binding="{Binding Before}" Width="100" />
                                <DataGridTextColumn Header="{loc:Loc Events_After}" Binding="{Binding After}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
