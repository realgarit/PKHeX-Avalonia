<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation"
             xmlns:loc="using:PKHeX.Avalonia.Localization"
             xmlns:controls="clr-namespace:PKHeX.Avalonia.Controls"
             x:Class="PKHeX.Avalonia.Views.PokemonEditor"
             x:DataType="vm:PokemonEditorViewModel"
             Focusable="False"
             KeyboardNavigation.IsTabStop="False">

    <UserControl.Styles>
        <!-- Keep the editor on the shared neutral focus treatment. The editor navigation is a
             local composition around the native TabControl so the compact column does not make
             the production tab strip clip or discard advanced sections. -->
        <Style Selector="Border">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="ContentControl">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.editor-nav">
            <Setter Property="ContentTemplate">
                <DataTemplate x:CompileBindings="False">
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center" />
                </DataTemplate>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="1,3,1,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.editor-nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.editor-nav:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderFocusBrush}" />
        </Style>
        <Style Selector="Button.editor-nav.selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CompactAccentTextBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.editor-more">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource UiDensityControlRadius}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.editor-more:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.editor-more.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource CompactAccentTextBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        </Style>
        <!-- Avalonia's TabStripPlacement has no None value. Hide only this editor's native strip
             while retaining the real TabControl/content selection underneath the compact buttons. -->
        <Style Selector="TabControl.editor-tabs /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel.compact-main-form TextBox, StackPanel.compact-main-form ComboBox, StackPanel.compact-main-form NumericUpDown, StackPanel.compact-main-form controls|FilterableComboBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="{DynamicResource UiDensityControlHeight}" />
        </Style>
        <Style Selector="StackPanel.compact-main-form TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.compact-main-form ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TabControl.editor-tabs">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="TabControl.editor-tabs TextBlock">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TabControl.editor-tabs TextBox">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TabControl.editor-tabs ComboBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MaxDropDownHeight" Value="240" />
        </Style>
        <Style Selector="TabControl.editor-tabs AutoCompleteBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MaxDropDownHeight" Value="240" />
        </Style>
        <Style Selector="TabControl.editor-tabs NumericUpDown">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TabControl.editor-tabs CalendarDatePicker">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TabControl.editor-tabs Border.editor-section">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ToggleButton#MainDetailsToggle:checked Path">
            <Setter Property="Data" Value="M1 5 L5 1 L9 5" />
        </Style>
    </UserControl.Styles>

        <!-- AllowDrop lives here (not on the root UserControl): Avalonia's drag/drop target
             resolution requires AllowDrop on the exact innermost hit-test-visible element under
             the pointer, and this Border's Background covers the editor's full visible area. -->
        <Border x:Name="EditorSurface" Padding="17,6,17,12" Background="{DynamicResource ThemeBackgroundCardBrush}" VerticalAlignment="Stretch"
                DragDrop.AllowDrop="True"
                DragDrop.Drop="OnEditorDrop"
                DragDrop.DragOver="OnEditorDragOver">
            <Grid RowDefinitions="94,36,*,36" VerticalAlignment="Stretch">
                <Grid Grid.Row="0" ColumnDefinitions="81,*">
                    <Image Source="{Binding Sprite, Converter={StaticResource PngBytesToBitmap}}" Width="76" Height="76" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality" AutomationProperties.Name="{Binding Title}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Species, StringFormat='#{0:D4}'}" FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}" />
                        <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Nickname}" />
                        <TextBlock Text="{Binding Level, StringFormat='Lv. {0}'}" FontSize="11" Foreground="{DynamicResource CompactAccentTextBrush}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <Button x:Name="LegalityPill" IsVisible="{Binding ShowLegalityStatus}" Background="Transparent" BorderThickness="0" CornerRadius="13" Padding="0" MinHeight="26"
                            Command="{Binding ShowLegalityCommand}" ToolTip.Tip="{Binding LegalityReport}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{Binding LegalityReport}">
                        <Panel>
                            <Grid IsVisible="{Binding IsLegal}">
                                <Border Background="{DynamicResource ThemeSuccessBrush}" Opacity="0.12" CornerRadius="13" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="9,5">
                                    <Path Width="12" Height="12" Data="M2 6 L5 9 L11 2" Stroke="{DynamicResource ThemeSuccessBrush}" StrokeThickness="1.6" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc PokemonEditor_Legal}" Foreground="{DynamicResource ThemeSuccessBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Grid IsVisible="{Binding !IsLegal}">
                                <Border Background="{DynamicResource ThemeErrorBrush}" Opacity="0.10" CornerRadius="13" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="9,5">
                                    <Path Width="12" Height="12" Data="M6 0.75 A5.25 5.25 0 1 1 5.99 0.75 M6 3 V6.5 M6 8.5 V9"
                                          Stroke="{DynamicResource ThemeErrorBrush}" StrokeThickness="1.25" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc PokemonEditor_Illegal}" Foreground="{DynamicResource ThemeErrorBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Panel>
                    </Button>
                    <Button x:Name="ShinyToggle" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6,3" MinHeight="26" VerticalAlignment="Center"
                            Command="{Binding ToggleShinyCommand}" ToolTip.Tip="{loc:Loc PokemonEditor_ToggleShinyTooltip}" AutomationProperties.Name="{loc:Loc PokemonEditor_ToggleShinyTooltip}">
                        <Panel>
                            <Path Width="15" Height="15" Stretch="Uniform" IsVisible="{Binding IsShiny}" Data="M10 0 L13 7 L20 7 L15 12 L17 19 L10 15 L3 19 L5 12 L0 7 L7 7 Z" Fill="{DynamicResource ThemeShinyBrush}" />
                            <Path Width="15" Height="15" Stretch="Uniform" IsVisible="{Binding !IsShiny}" Data="M10 0 L13 7 L20 7 L15 12 L17 19 L10 15 L3 19 L5 12 L0 7 L7 7 Z" Stroke="{DynamicResource ThemeTextMutedBrush}" StrokeThickness="1.5" />
                        </Panel>
                    </Button>
                </Grid>

                <!-- Compact primary navigation. The content remains a real TabControl below, so
                     existing consumers and index-based tests retain their current tab ordering. -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,2,0,4">
                    <UniformGrid Grid.Column="0" Columns="5" Rows="1" Margin="0,0,4,0">
                        <Button x:Name="MainTabButton" Classes="editor-nav" Classes.selected="{Binding IsMainEditorSection}" Tag="0" Command="{Binding SelectEditorSectionCommand}" CommandParameter="0"
                                Content="{loc:Loc PokemonEditor_TabMain}" ToolTip.Tip="{loc:Loc PokemonEditor_TabMain}"
                                AutomationProperties.Name="{loc:Loc PokemonEditor_TabMain}" />
                        <Button x:Name="StatsTabButton" Classes="editor-nav" Classes.selected="{Binding IsStatsEditorSection}" Tag="1" Command="{Binding SelectEditorSectionCommand}" CommandParameter="1"
                                Content="{loc:Loc PokemonEditor_TabStats}" ToolTip.Tip="{loc:Loc PokemonEditor_TabStats}"
                                AutomationProperties.Name="{loc:Loc PokemonEditor_TabStats}" />
                        <Button x:Name="MetTabButton" Classes="editor-nav" Classes.selected="{Binding IsMetEditorSection}" Tag="2" Command="{Binding SelectEditorSectionCommand}" CommandParameter="2"
                                Content="{loc:Loc PokemonEditor_TabMet}" ToolTip.Tip="{loc:Loc PokemonEditor_TabMet}"
                                AutomationProperties.Name="{loc:Loc PokemonEditor_TabMet}" />
                        <Button x:Name="MovesTabButton" Classes="editor-nav" Classes.selected="{Binding IsMovesEditorSection}" Tag="3" Command="{Binding SelectEditorSectionCommand}" CommandParameter="3"
                                Content="{loc:Loc PokemonEditor_TabMoves}" ToolTip.Tip="{loc:Loc PokemonEditor_TabMoves}"
                                AutomationProperties.Name="{loc:Loc PokemonEditor_TabMoves}" />
                        <Button x:Name="OtMiscTabButton" Classes="editor-nav" Classes.selected="{Binding IsOtEditorSection}" Tag="4" Command="{Binding SelectEditorSectionCommand}" CommandParameter="4"
                                Content="{loc:Loc PokemonEditor_TabOtMisc}" ToolTip.Tip="{loc:Loc PokemonEditor_TabOtMisc}"
                                AutomationProperties.Name="{loc:Loc PokemonEditor_TabOtMisc}" />
                    </UniformGrid>
                    <Button x:Name="MoreSectionsButton" Grid.Column="1" Classes="editor-more" Classes.selected="{Binding IsAdvancedEditorSection}"
                            Content="{loc:Loc CompactUI_MoreSections}"
                            AutomationProperties.Name="{loc:Loc CompactUI_MoreSections}">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{loc:Loc PokemonEditor_TabContest}" Tag="5"
                                          IsVisible="{Binding HasContestStats}" Command="{Binding SelectEditorSectionCommand}" CommandParameter="5" />
                                <MenuItem Header="{loc:Loc PokemonEditor_TabMemory}" Tag="6"
                                          IsVisible="{Binding HasMemories}" Command="{Binding SelectEditorSectionCommand}" CommandParameter="6" />
                                <MenuItem Header="{loc:Loc PokemonEditor_TabRibbons}" Tag="7"
                                          IsVisible="{Binding HasRibbons}" Command="{Binding SelectEditorSectionCommand}" CommandParameter="7" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- Tab Control -->
                <TabControl x:Name="EditorTabs" Grid.Row="2" Classes="editor-tabs" TabStripPlacement="Top" Focusable="False"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            SelectedIndex="{Binding SelectedEditorSection, Mode=TwoWay}"
                            ClipToBounds="True">
                    <TabItem Classes="editor-tab" Header="{loc:Loc PokemonEditor_TabMain}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="9" Margin="0,8,0,4" Classes="compact-main-form">
                                <Grid ColumnDefinitions="71,*" ><TextBlock Text="{loc:Loc PokemonEditor_Species}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><Border Grid.Column="1"><Grid><controls:FilterableComboBox Classes="compact-select" ItemsSource="{Binding SpeciesList}" SelectedValue="{Binding Species}" HorizontalAlignment="Stretch" Padding="9,5,24,5" AutomationProperties.Name="{loc:Loc PokemonEditor_Species}" /><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="10" Height="6" Data="M1 1 L5 5 L9 1" Stroke="{DynamicResource ThemeTextMutedBrush}" StrokeThickness="1" IsHitTestVisible="False" /></Grid></Border></Grid>
                                <Grid ColumnDefinitions="71,*" ><TextBlock Text="{loc:Loc PokemonEditor_Nickname}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><Border Grid.Column="1"><TextBox x:Name="NicknameField" Text="{Binding Nickname}" AutomationProperties.Name="{loc:Loc PokemonEditor_Nickname}" /></Border></Grid>
                                <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel Spacing="4"><TextBlock Text="{loc:Loc PokemonEditor_Level}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" /><NumericUpDown Value="{Binding Level}" Minimum="1" Maximum="100" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_Level}" /></StackPanel>
                                    <Border Grid.Column="2"><StackPanel Spacing="4"><TextBlock Text="{loc:Loc PokemonEditor_Nature}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" /><ComboBox ItemsSource="{Binding NatureList}" SelectedValue="{Binding Nature}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Text}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc PokemonEditor_Nature}" /></StackPanel></Border>
                                </Grid>
                                <Grid ColumnDefinitions="71,*" ><TextBlock Text="{loc:Loc PokemonEditor_Ability}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding AbilityList}" SelectedValue="{Binding Ability}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Text}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc PokemonEditor_Ability}" /></Border></Grid>
                                <Grid ColumnDefinitions="71,*" ><TextBlock Text="{loc:Loc PokemonEditor_HeldItem}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><Border Grid.Column="1"><Grid><controls:FilterableComboBox Classes="compact-select" ItemsSource="{Binding ItemList}" SelectedValue="{Binding HeldItem}" HorizontalAlignment="Stretch" Padding="9,5,24,5" AutomationProperties.Name="{loc:Loc PokemonEditor_HeldItem}" /><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="10" Height="6" Data="M1 1 L5 5 L9 1" Stroke="{DynamicResource ThemeTextMutedBrush}" StrokeThickness="1" IsHitTestVisible="False" /></Grid></Border></Grid>
                                <Grid ColumnDefinitions="71,*" ><TextBlock Text="{loc:Loc PokemonEditor_Gender}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding PokemonGenderList}" SelectedValue="{Binding Gender}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Text}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc PokemonEditor_Gender}" /></Border></Grid>
                                <Grid ColumnDefinitions="71,*" IsVisible="{Binding HasForms}"><TextBlock Text="{loc:Loc PokemonEditor_Form}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding FormList}" SelectedValue="{Binding Form}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Text}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc PokemonEditor_Form}" /></Border></Grid>
                                <ToggleButton x:Name="MainDetailsToggle" AutomationProperties.Name="{loc:Loc CompactUI_Details}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThemeBorderMutedBrush}" Padding="0,6" MinHeight="30">
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc CompactUI_Details}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" /><Path Grid.Column="1" Width="10" Height="6" Data="M1 1 L5 5 L9 1" Stroke="{DynamicResource ThemeTextMutedBrush}" StrokeThickness="1" /></Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding #MainDetailsToggle.IsChecked}">
                                    <StackPanel Spacing="9" Margin="0,6,0,0">
                                        <Grid ColumnDefinitions="71,*" ><TextBlock Text="{loc:Loc PokemonEditor_Ball}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding BallList}" SelectedValue="{Binding Ball}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Text}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc PokemonEditor_Ball}" /></Border></Grid>
                                        <Grid ColumnDefinitions="71,*" ><TextBlock Text="{loc:Loc PokemonEditor_Language}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding LanguageList}" SelectedValue="{Binding Language}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Text}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc PokemonEditor_Language}" /></Border></Grid>
                                        <Grid ColumnDefinitions="71,*" IsVisible="{Binding ShowStatAlignment}"><TextBlock Text="{loc:Loc PokemonEditor_StatAlignment}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox ItemsSource="{Binding NatureList}" SelectedValue="{Binding StatAlignment}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Text}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc PokemonEditor_StatAlignment}" /></Border></Grid>
                                        <Grid ColumnDefinitions="71,*" ><TextBlock Text="{loc:Loc PokemonEditor_Exp}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><Border Grid.Column="1"><NumericUpDown Value="{Binding Exp}" Minimum="0" Maximum="10000000" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_Exp}" /></Border></Grid>
                                        <Border x:Name="ExpBar"
                                                Height="14" Margin="0,6,0,0"
                                                CornerRadius="7"
                                                Background="{DynamicResource ThemeControlBackgroundBrush}"
                                                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                ClipToBounds="True"
                                                ToolTip.Tip="{Binding ExpPercent, StringFormat='Experience: {0:P0}'}"
                                                AutomationProperties.Name="{loc:Loc PokemonEditor_Exp}"
                                                PointerPressed="ExpBar_PointerPressed"
                                                PointerMoved="ExpBar_PointerMoved">
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ExpPercent}"
                                                         IsHitTestVisible="False"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource CompactAccentTextBrush}"
                                                         CornerRadius="7"
                                                         MinHeight="0" />
                                        </Border>
                                        <CheckBox Content="{loc:Loc PokemonEditor_IsEgg}" IsChecked="{Binding IsEgg}" AutomationProperties.Name="{loc:Loc PokemonEditor_IsEgg}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                <!-- Stats Tab -->
                <TabItem Classes="editor-tab" Header="{loc:Loc PokemonEditor_TabStats}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8" Margin="0,8,0,4">
                        <TextBlock Text="{loc:Loc PokemonEditor_HaXStatsWarning}"
                                   IsVisible="{Binding IsHaXMode}"
                                   Foreground="{DynamicResource ThemeWarningBrush}"
                                   TextWrapping="Wrap"
                                   Margin="2,0,2,0" />
                        <Border Classes="editor-section">
                            <Grid ColumnDefinitions="40,40,42,42,30,26" RowDefinitions="Auto,Auto,4,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <Grid Grid.Row="9" Grid.ColumnSpan="6" ColumnDefinitions="*,*" Margin="0,8,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{loc:Loc BoxReportView_IvTotalHeader}" Foreground="{DynamicResource ThemeTextMutedBrush}" /><TextBlock Text="{Binding IVTotal}" FontWeight="SemiBold" /></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><TextBlock Text="{loc:Loc BoxReportView_EvTotalHeader}" Foreground="{DynamicResource ThemeTextMutedBrush}" /><TextBlock Text="{Binding EVTotal}" FontWeight="SemiBold" /></StackPanel>
                                </Grid>
                                <!-- Actions stay above the compact column labels so they never compete
                                     with IV/EV headers for horizontal space. -->
                                <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,0,0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                        <Button Content="{loc:Loc PokemonEditor_ColMax}" Command="{Binding SetMaxIVsCommand}"
                                                FontSize="10" Padding="5,1" Height="22"
                                                ToolTip.Tip="{loc:Loc PokemonEditor_MaxIvsTooltip}"
                                                AutomationProperties.Name="{loc:Loc PokemonEditor_ColMax}" />
                                        <Button Content="{loc:Loc PokemonEditor_ColClear}" Command="{Binding ClearEVsCommand}"
                                                FontSize="10" Padding="5,1" Height="22"
                                                ToolTip.Tip="{loc:Loc PokemonEditor_ClearEvsTooltip}"
                                                AutomationProperties.Name="{loc:Loc PokemonEditor_ColClear}" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc PokemonEditor_TabStats}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Compact, fixed-width labels remain aligned at the shell's 360px minimum. -->
                                <TextBlock x:Name="StatsHeaderStat" Grid.Row="1" Grid.Column="0" Text="{loc:Loc PokemonEditor_ColStat}" FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Left" />
                                <TextBlock x:Name="StatsHeaderBase" Grid.Row="1" Grid.Column="1" Text="{loc:Loc PokemonEditor_ColBase}" FontWeight="Bold" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                                <TextBlock x:Name="StatsHeaderIVs" Grid.Row="1" Grid.Column="2" Text="{loc:Loc PokemonEditor_ColIVs}" FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Center" />
                                <TextBlock x:Name="StatsHeaderEVs" Grid.Row="1" Grid.Column="3" Text="{loc:Loc PokemonEditor_ColEVs}" FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Center" />
                                <TextBlock x:Name="StatsHeaderTotal" Grid.Row="1" Grid.Column="4" Text="Σ" FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Center" ToolTip.Tip="{loc:Loc PokemonEditor_ColTotal}" />
                                <TextBlock x:Name="StatsHeaderHyperTraining" Grid.Row="1" Grid.Column="5" Text="{loc:Loc PokemonEditor_ColHyperTrainingShort}" FontWeight="Bold" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" ToolTip.Tip="{loc:Loc StatsHyperTrained}" />

                                <!-- HP -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc PokemonEditor_StatHp}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Base_HP}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                                <NumericUpDown Grid.Row="3" Grid.Column="2" Value="{Binding IvHP}" Minimum="0" Maximum="31" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding HpIvAutomationName}" />
                                <NumericUpDown Grid.Row="3" Grid.Column="3" Value="{Binding EvHP}" Minimum="0" Maximum="252" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding HpEvAutomationName}" />
                                <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding Stat_HP}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsHaXMode}" />
                                <NumericUpDown Grid.Row="3" Grid.Column="4" Value="{Binding HaXStatHP}" Minimum="0" Maximum="65535" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" IsVisible="{Binding IsHaXMode}" AutomationProperties.Name="{loc:Loc PokemonEditor_StatHp}" />
                                <CheckBox Grid.Row="3" Grid.Column="5" IsChecked="{Binding HyperTrainedHP, Mode=TwoWay}" IsEnabled="{Binding CanHyperTrain}" IsVisible="{Binding HasHyperTraining}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding HyperTrainedHpAutomationName}" />

                                <!-- Atk -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc PokemonEditor_StatAtk}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Base_ATK}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                                <NumericUpDown Grid.Row="4" Grid.Column="2" Value="{Binding IvATK}" Minimum="0" Maximum="31" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding AtkIvAutomationName}" />
                                <NumericUpDown Grid.Row="4" Grid.Column="3" Value="{Binding EvATK}" Minimum="0" Maximum="252" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding AtkEvAutomationName}" />
                                <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding Stat_ATK}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsHaXMode}" />
                                <NumericUpDown Grid.Row="4" Grid.Column="4" Value="{Binding HaXStatATK}" Minimum="0" Maximum="65535" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" IsVisible="{Binding IsHaXMode}" AutomationProperties.Name="{loc:Loc PokemonEditor_StatAtk}" />
                                <CheckBox Grid.Row="4" Grid.Column="5" IsChecked="{Binding HyperTrainedATK, Mode=TwoWay}" IsEnabled="{Binding CanHyperTrain}" IsVisible="{Binding HasHyperTraining}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding HyperTrainedAtkAutomationName}" />

                                <!-- Def -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc PokemonEditor_StatDef}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Base_DEF}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                                <NumericUpDown Grid.Row="5" Grid.Column="2" Value="{Binding IvDEF}" Minimum="0" Maximum="31" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding DefIvAutomationName}" />
                                <NumericUpDown Grid.Row="5" Grid.Column="3" Value="{Binding EvDEF}" Minimum="0" Maximum="252" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding DefEvAutomationName}" />
                                <TextBlock Grid.Row="5" Grid.Column="4" Text="{Binding Stat_DEF}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsHaXMode}" />
                                <NumericUpDown Grid.Row="5" Grid.Column="4" Value="{Binding HaXStatDEF}" Minimum="0" Maximum="65535" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" IsVisible="{Binding IsHaXMode}" AutomationProperties.Name="{loc:Loc PokemonEditor_StatDef}" />
                                <CheckBox Grid.Row="5" Grid.Column="5" IsChecked="{Binding HyperTrainedDEF, Mode=TwoWay}" IsEnabled="{Binding CanHyperTrain}" IsVisible="{Binding HasHyperTraining}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding HyperTrainedDefAutomationName}" />

                                <!-- SpA -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc PokemonEditor_StatSpa}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Base_SPA}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                                <NumericUpDown Grid.Row="6" Grid.Column="2" Value="{Binding IvSPA}" Minimum="0" Maximum="31" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding SpaIvAutomationName}" />
                                <NumericUpDown Grid.Row="6" Grid.Column="3" Value="{Binding EvSPA}" Minimum="0" Maximum="252" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding SpaEvAutomationName}" />
                                <TextBlock Grid.Row="6" Grid.Column="4" Text="{Binding Stat_SPA}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsHaXMode}" />
                                <NumericUpDown Grid.Row="6" Grid.Column="4" Value="{Binding HaXStatSPA}" Minimum="0" Maximum="65535" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" IsVisible="{Binding IsHaXMode}" AutomationProperties.Name="{loc:Loc PokemonEditor_StatSpa}" />
                                <CheckBox Grid.Row="6" Grid.Column="5" IsChecked="{Binding HyperTrainedSPA, Mode=TwoWay}" IsEnabled="{Binding CanHyperTrain}" IsVisible="{Binding HasHyperTraining}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding HyperTrainedSpaAutomationName}" />

                                <!-- SpD -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Loc PokemonEditor_StatSpd}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Base_SPD}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                                <NumericUpDown Grid.Row="7" Grid.Column="2" Value="{Binding IvSPD}" Minimum="0" Maximum="31" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding SpdIvAutomationName}" />
                                <NumericUpDown Grid.Row="7" Grid.Column="3" Value="{Binding EvSPD}" Minimum="0" Maximum="252" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding SpdEvAutomationName}" />
                                <TextBlock Grid.Row="7" Grid.Column="4" Text="{Binding Stat_SPD}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsHaXMode}" />
                                <NumericUpDown Grid.Row="7" Grid.Column="4" Value="{Binding HaXStatSPD}" Minimum="0" Maximum="65535" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" IsVisible="{Binding IsHaXMode}" AutomationProperties.Name="{loc:Loc PokemonEditor_StatSpd}" />
                                <CheckBox Grid.Row="7" Grid.Column="5" IsChecked="{Binding HyperTrainedSPD, Mode=TwoWay}" IsEnabled="{Binding CanHyperTrain}" IsVisible="{Binding HasHyperTraining}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding HyperTrainedSpdAutomationName}" />

                                <!-- Spe -->
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:Loc PokemonEditor_StatSpe}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Base_SPE}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                                <NumericUpDown Grid.Row="8" Grid.Column="2" Value="{Binding IvSPE}" Minimum="0" Maximum="31" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding SpeIvAutomationName}" />
                                <NumericUpDown Grid.Row="8" Grid.Column="3" Value="{Binding EvSPE}" Minimum="0" Maximum="252" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" AutomationProperties.Name="{Binding SpeEvAutomationName}" />
                                <TextBlock Grid.Row="8" Grid.Column="4" Text="{Binding Stat_SPE}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsHaXMode}" />
                                <NumericUpDown Grid.Row="8" Grid.Column="4" Value="{Binding HaXStatSPE}" Minimum="0" Maximum="65535" FormatString="0" Classes="compact stats-number" HorizontalAlignment="Stretch" Margin="2" IsVisible="{Binding IsHaXMode}" AutomationProperties.Name="{loc:Loc PokemonEditor_StatSpe}" />
                                <CheckBox Grid.Row="8" Grid.Column="5" IsChecked="{Binding HyperTrainedSPE, Mode=TwoWay}" IsEnabled="{Binding CanHyperTrain}" IsVisible="{Binding HasHyperTraining}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding HyperTrainedSpeAutomationName}" />
                            </Grid>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Met Tab -->
                <TabItem Classes="editor-tab" Header="{loc:Loc PokemonEditor_TabMet}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,4" Spacing="8">
                            <!-- Origin Game -->
                            <StackPanel>
                                    <TextBlock Classes="form-label" Text="{loc:Loc PokemonEditor_OriginGame}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding OriginGameList}"
                                          SelectedValue="{Binding OriginGame}"
                                          SelectedValueBinding="{Binding Value}"
                                          DisplayMemberBinding="{Binding Text}"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{loc:Loc PokemonEditor_OriginGame}" />
                            </StackPanel>

                            <!-- Met Location -->
                            <StackPanel>
                                <TextBlock Classes="form-label" Text="{loc:Loc PokemonEditor_MetLocation}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding MetLocationList}"
                                          SelectedValue="{Binding MetLocation}"
                                          SelectedValueBinding="{Binding Value}"
                                          DisplayMemberBinding="{Binding Text}"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{loc:Loc PokemonEditor_MetLocation}" />
                            </StackPanel>

                            <!-- Met Level and Date Row -->
                            <Grid ColumnDefinitions="64,12,*" RowDefinitions="Auto,Auto" RowSpacing="4" VerticalAlignment="Center">
                                <TextBlock Grid.Row="0" Classes="form-label" Text="{loc:Loc PokemonEditor_MetLevel}" FontWeight="SemiBold" Margin="0" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2" IsVisible="{Binding HasMetDate}" Classes="form-label" Text="{loc:Loc PokemonEditor_MetDate}" FontWeight="SemiBold" Margin="0" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="1" Value="{Binding MetLevel}" ShowButtonSpinner="False" Minimum="0" Maximum="100" FormatString="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc PokemonEditor_MetLevel}" />
                                <CalendarDatePicker Grid.Row="1" Grid.Column="2" IsVisible="{Binding HasMetDate}" SelectedDate="{Binding MetDate}" SelectedDateFormat="Short"
                                                    Watermark="{loc:Loc PokemonEditor_SelectDate}"
                                                    ToolTip.Tip="{loc:Loc PokemonEditor_SelectDate}"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                    AutomationProperties.Name="{loc:Loc PokemonEditor_MetDate}" />
                            </Grid>

                            <!-- Egg Location -->
                            <StackPanel>
                                <TextBlock Classes="form-label" Text="{loc:Loc PokemonEditor_EggLocation}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding EggLocationList}"
                                          SelectedValue="{Binding EggLocation}"
                                          SelectedValueBinding="{Binding Value}"
                                          DisplayMemberBinding="{Binding Text}"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{loc:Loc PokemonEditor_EggLocation}" />
                            </StackPanel>

                            <!-- Egg Date -->
                            <StackPanel>
                                <TextBlock Classes="form-label" Text="{loc:Loc PokemonEditor_EggDate}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <CalendarDatePicker SelectedDate="{Binding EggDate}" SelectedDateFormat="Short"
                                                    Watermark="{loc:Loc PokemonEditor_SelectDate}"
                                                    ToolTip.Tip="{loc:Loc PokemonEditor_SelectDate}"
                                                    HorizontalAlignment="Stretch"
                                                    AutomationProperties.Name="{loc:Loc PokemonEditor_EggDate}" />
                            </StackPanel>

                            <CheckBox Content="{loc:Loc PokemonEditor_FatefulEncounter}" IsChecked="{Binding IsFatefulEncounter}" AutomationProperties.Name="{loc:Loc PokemonEditor_FatefulEncounter}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Moves Tab -->
                <TabItem Classes="editor-tab" Header="{loc:Loc PokemonEditor_TabMoves}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8" Margin="0,8,0,4">
                            <!-- Current Moves Section -->
                            <StackPanel Spacing="8">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{loc:Loc PokemonEditor_CurrentMoves}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                    <Button Content="{loc:Loc PokemonEditor_Suggest}" Command="{Binding SuggestCurrentMovesCommand}"
                                            HorizontalAlignment="Right" Padding="8,2" FontSize="12"
                                            ToolTip.Tip="{loc:Loc PokemonEditor_SuggestCurrentMovesTooltip}"
                                            AutomationProperties.Name="{loc:Loc PokemonEditor_Suggest}" />
                                </DockPanel>

                                <Grid ColumnDefinitions="*,8,40,8,38" RowDefinitions="22,Auto,Auto,Auto,Auto" RowSpacing="7">
                                    <TextBlock Text="{loc:Loc PokemonEditor_Move}" Foreground="{DynamicResource ThemeTextMutedBrush}" />
                                    <TextBlock Grid.Column="2" Text="{loc:Loc PokemonEditor_Pp}" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{loc:Loc PokemonEditor_Ups}" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" />
                                    <controls:FilterableComboBox Grid.Row="1" ItemsSource="{Binding MoveList}" SelectedValue="{Binding Move1}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Move1AutomationName}" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="2" MinWidth="0" Width="40" HorizontalContentAlignment="Center" Value="{Binding Pp1}" Minimum="0" Maximum="64" FormatString="0" ShowButtonSpinner="False" Padding="5,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Pp1AutomationName}" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="4" MinWidth="0" Width="38" HorizontalContentAlignment="Center" Value="{Binding PpUps1}" Minimum="0" Maximum="3" FormatString="0" ShowButtonSpinner="False" Padding="5,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding PpUps1AutomationName}" />
                                    <controls:FilterableComboBox Grid.Row="2" ItemsSource="{Binding MoveList}" SelectedValue="{Binding Move2}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Move2AutomationName}" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="2" MinWidth="0" Width="40" HorizontalContentAlignment="Center" Value="{Binding Pp2}" Minimum="0" Maximum="64" FormatString="0" ShowButtonSpinner="False" Padding="5,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Pp2AutomationName}" />
                                    <NumericUpDown Grid.Row="2" Grid.Column="4" MinWidth="0" Width="38" HorizontalContentAlignment="Center" Value="{Binding PpUps2}" Minimum="0" Maximum="3" FormatString="0" ShowButtonSpinner="False" Padding="5,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding PpUps2AutomationName}" />
                                    <controls:FilterableComboBox Grid.Row="3" ItemsSource="{Binding MoveList}" SelectedValue="{Binding Move3}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Move3AutomationName}" />
                                    <NumericUpDown Grid.Row="3" Grid.Column="2" MinWidth="0" Width="40" HorizontalContentAlignment="Center" Value="{Binding Pp3}" Minimum="0" Maximum="64" FormatString="0" ShowButtonSpinner="False" Padding="5,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Pp3AutomationName}" />
                                    <NumericUpDown Grid.Row="3" Grid.Column="4" MinWidth="0" Width="38" HorizontalContentAlignment="Center" Value="{Binding PpUps3}" Minimum="0" Maximum="3" FormatString="0" ShowButtonSpinner="False" Padding="5,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding PpUps3AutomationName}" />
                                    <controls:FilterableComboBox Grid.Row="4" ItemsSource="{Binding MoveList}" SelectedValue="{Binding Move4}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Move4AutomationName}" />
                                    <NumericUpDown Grid.Row="4" Grid.Column="2" MinWidth="0" Width="40" HorizontalContentAlignment="Center" Value="{Binding Pp4}" Minimum="0" Maximum="64" FormatString="0" ShowButtonSpinner="False" Padding="5,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Pp4AutomationName}" />
                                    <NumericUpDown Grid.Row="4" Grid.Column="4" MinWidth="0" Width="38" HorizontalContentAlignment="Center" Value="{Binding PpUps4}" Minimum="0" Maximum="3" FormatString="0" ShowButtonSpinner="False" Padding="5,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding PpUps4AutomationName}" />
                                </Grid>
                            </StackPanel>

                            <!-- Relearn Section -->
                            <!-- Relearn Section -->
                            <StackPanel Spacing="4">
                                <DockPanel>
                                    <TextBlock Text="{loc:Loc PokemonEditor_RelearnMoves}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                    <Button Content="{loc:Loc PokemonEditor_Suggest}" Command="{Binding SuggestRelearnMovesCommand}"
                                            HorizontalAlignment="Right" Padding="8,2" FontSize="12"
                                            ToolTip.Tip="{loc:Loc PokemonEditor_SuggestRelearnMovesTooltip}"
                                            AutomationProperties.Name="{loc:Loc PokemonEditor_Suggest}" />
                                </DockPanel>

                                <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,0">
                                     <TextBlock Grid.Column="0" Text="{loc:Loc PokemonEditor_Move}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="4,0,0,0" />
                                     <TextBlock Grid.Column="2" Text="{loc:Loc PokemonEditor_Move}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="4,0,0,0" />
                                </Grid>

                                <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,4,Auto">
                                    <controls:FilterableComboBox Grid.Row="0" Grid.Column="0"
                                              ItemsSource="{Binding RelearnMoveDataSource}" SelectedValue="{Binding RelearnMove1}"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="{Binding RelearnMove1AutomationName}" />
                                    <controls:FilterableComboBox Grid.Row="0" Grid.Column="2"
                                              ItemsSource="{Binding RelearnMoveDataSource}" SelectedValue="{Binding RelearnMove2}"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="{Binding RelearnMove2AutomationName}" />
                                    <controls:FilterableComboBox Grid.Row="2" Grid.Column="0"
                                              ItemsSource="{Binding RelearnMoveDataSource}" SelectedValue="{Binding RelearnMove3}"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="{Binding RelearnMove3AutomationName}" />
                                    <controls:FilterableComboBox Grid.Row="2" Grid.Column="2"
                                              ItemsSource="{Binding RelearnMoveDataSource}" SelectedValue="{Binding RelearnMove4}"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="{Binding RelearnMove4AutomationName}" />
                                </Grid>
                            </StackPanel>

                            <!-- Tech Records (Gen 8+) -->
                            <Border IsVisible="{Binding HasTechRecords}" Padding="8,0" Margin="0,6,0,0"
                                    BorderBrush="{DynamicResource ThemeBorderDefaultBrush}" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="8" Margin="0,6,0,0">
                                    <TextBlock Text="{loc:Loc PokemonEditor_TechRecords}" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{loc:Loc PokemonEditor_OpenEditor}" Command="{Binding OpenTechRecordEditorCommand}" />
                                        <Button Content="{loc:Loc PokemonEditor_SetAllLegal}" Command="{Binding SetAllTechRecordsCommand}" />
                                        <Button Content="{loc:Loc PokemonEditor_ClearAll}" Command="{Binding ClearTechRecordsCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- OT/Misc Tab -->
                <TabItem Classes="editor-tab" Header="{loc:Loc PokemonEditor_TabOtMisc}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8" Margin="0,8,0,4">
                            <!-- Original Trainer Card -->
                            <Border Classes="editor-section">
                                <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="{loc:Loc PokemonEditor_OriginalTrainer}" FontWeight="Bold" Margin="0,0,0,6" Opacity="0.6" />

                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="{loc:Loc PokemonEditor_Name}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding OriginalTrainerName}" AutomationProperties.Name="{loc:Loc PokemonEditor_Name}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="{loc:Loc PokemonEditor_Gender}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding GenderList}"
                                                  SelectedValue="{Binding OriginalTrainerGender}" SelectedValueBinding="{Binding Value}"
                                                  DisplayMemberBinding="{Binding Text}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc PokemonEditor_Gender}" />
                                    </StackPanel>

                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Tid}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding TrainerID}" Minimum="0" Maximum="4294967295" FormatString="0" ShowButtonSpinner="False"
                                                           AutomationProperties.Name="{loc:Loc PokemonEditor_Tid}"
                                                           ToolTip.Tip="{Binding Tsv, StringFormat='TSV: {0}'}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Sid}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding Sid}" Minimum="0" Maximum="65535" FormatString="0" ShowButtonSpinner="False"
                                                           AutomationProperties.Name="{loc:Loc PokemonEditor_Sid}"
                                                           ToolTip.Tip="{Binding Tsv, StringFormat='TSV: {0}'}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0"
                                                   Opacity="0.6" Text="{Binding Tsv, StringFormat='TSV: {0}'}"
                                                   AutomationProperties.Name="{loc:Loc PokemonEditor_TrainerShinyValue}" />
                                    </Grid>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                        <TextBlock Text="{loc:Loc MemoryEditor_OtFriendship}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <NumericUpDown Value="{Binding OriginalTrainerFriendship}" Minimum="0" Maximum="255" FormatString="0" ShowButtonSpinner="False"
                                                       AutomationProperties.Name="{loc:Loc MemoryEditor_OtFriendship}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Latest Handling Trainer Card -->
                            <Border IsVisible="{Binding CanEditHandlingTrainer}" Classes="editor-section">
                                <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="{loc:Loc MemoryEditor_HandlingTrainer}" FontWeight="Bold" Margin="0,0,0,6" Opacity="0.6" />

                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="{loc:Loc PokemonEditor_Name}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding HandlingTrainerName}" AutomationProperties.Name="{loc:Loc PokemonEditor_Name}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="{loc:Loc PokemonEditor_Gender}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding GenderList}"
                                                  SelectedValue="{Binding HandlingTrainerGender}" SelectedValueBinding="{Binding Value}"
                                                  DisplayMemberBinding="{Binding Text}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc PokemonEditor_Gender}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="{loc:Loc MemoryEditor_HtFriendship}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <NumericUpDown Value="{Binding HandlingTrainerFriendship}" Minimum="0" Maximum="255" FormatString="0" ShowButtonSpinner="False"
                                                       AutomationProperties.Name="{loc:Loc MemoryEditor_HtFriendship}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="{loc:Loc PokemonEditor_CurrentHandler}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding HandlerList}"
                                                  SelectedValue="{Binding CurrentHandler}" SelectedValueBinding="{Binding Value}"
                                                  DisplayMemberBinding="{Binding Text}" HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="{loc:Loc PokemonEditor_CurrentHandler}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Extra Info Card -->
                            <Border Classes="editor-section">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Loc PokemonEditor_EncryptionStatus}" FontWeight="Bold" Opacity="0.6" />

                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Pid}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding Pid}" FontFamily="Consolas" Height="32" VerticalContentAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="{loc:Loc PokemonEditor_Pid}" />
                                                <Button Grid.Column="1" Command="{Binding RerollPidCommand}" Width="34" Height="32"
                                                        FontSize="12" Padding="0"
                                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                        ToolTip.Tip="{loc:Loc PokemonEditor_RerollPidTooltip}"
                                                        AutomationProperties.Name="{loc:Loc PokemonEditor_RerollPidTooltip}">
                                                    <!-- Keep the die platform-neutral and geometrically centered; emoji glyphs vary
                                                         in baseline, weight, and available color fonts across Windows/macOS/Linux. -->
                                                    <Border Width="18" Height="18"
                                                            Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                                            BorderBrush="{DynamicResource ThemeTextSecondaryBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Canvas Width="14" Height="14">
                                                            <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="3" Height="3" Fill="{DynamicResource ThemeTextSecondaryBrush}" />
                                                            <Ellipse Canvas.Left="9.5" Canvas.Top="1.5" Width="3" Height="3" Fill="{DynamicResource ThemeTextSecondaryBrush}" />
                                                            <Ellipse Canvas.Left="5.5" Canvas.Top="5.5" Width="3" Height="3" Fill="{DynamicResource ThemeTextSecondaryBrush}" />
                                                            <Ellipse Canvas.Left="1.5" Canvas.Top="9.5" Width="3" Height="3" Fill="{DynamicResource ThemeTextSecondaryBrush}" />
                                                            <Ellipse Canvas.Left="9.5" Canvas.Top="9.5" Width="3" Height="3" Fill="{DynamicResource ThemeTextSecondaryBrush}" />
                                                        </Canvas>
                                                    </Border>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Ec}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding EncryptionConstant}" FontFamily="Consolas" Height="32" VerticalContentAlignment="Center" AutomationProperties.Name="{loc:Loc PokemonEditor_Ec}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Exp}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding Exp}" Minimum="0" Maximum="16400000" FormatString="0" ShowButtonSpinner="False"
                                                           AutomationProperties.Name="{loc:Loc PokemonEditor_Exp}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Friendship}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding Happiness}" Minimum="0" Maximum="255" FormatString="0" ShowButtonSpinner="False"
                                                           AutomationProperties.Name="{loc:Loc PokemonEditor_Friendship}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Pkrs}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <Grid ColumnDefinitions="*,8,*">
                                                <NumericUpDown Grid.Column="0" Value="{Binding PkrsDays}" Minimum="0" Maximum="15" FormatString="0" ShowButtonSpinner="False" MinWidth="56"
                                                               AutomationProperties.Name="{loc:Loc PokemonEditor_PkrsDaysRemaining}" />
                                                <NumericUpDown Grid.Column="2" Value="{Binding PkrsStrain}" Minimum="0" Maximum="15" FormatString="0" ShowButtonSpinner="False" MinWidth="56"
                                                               AutomationProperties.Name="{loc:Loc PokemonEditor_PkrsStrain}" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <CheckBox IsChecked="{Binding IsPokerusInfected, Mode=TwoWay}" Content="{loc:Loc MiscPokerusInfected}" AutomationProperties.Name="{loc:Loc MiscPokerusInfected}" />
                                                <CheckBox IsChecked="{Binding IsPokerusCured, Mode=TwoWay}" Content="{loc:Loc MiscPokerusCured}" AutomationProperties.Name="{loc:Loc MiscPokerusCured}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Form Argument -->
                            <Border IsVisible="{Binding ShowFormArgument}" Classes="editor-section">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc PokemonEditor_FormArgument}" FontWeight="Bold" Margin="0,0,0,6" Opacity="0.6" />
                                    <ComboBox IsVisible="{Binding ShowFormArgumentNamed}"
                                              ItemsSource="{Binding FormArgumentList}"
                                              SelectedIndex="{Binding FormArgumentValue}"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="{loc:Loc PokemonEditor_FormArgument}" />
                                    <NumericUpDown IsVisible="{Binding ShowFormArgumentRaw}"
                                                   Value="{Binding FormArgumentValue}" Minimum="0"
                                                   Maximum="{Binding FormArgumentMax}" FormatString="0"
                                                   ShowButtonSpinner="True"
                                                   AutomationProperties.Name="{loc:Loc PokemonEditor_FormArgument}" />
                                </StackPanel>
                            </Border>

                            <!-- Markings -->
                            <Border IsVisible="{Binding HasMarkings}" Classes="editor-section">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc PokemonEditor_Markings}" FontWeight="Bold" Margin="0,0,0,6" Opacity="0.6" />
                                    <UniformGrid Columns="6">
                                        <CheckBox Content="●" IsChecked="{Binding MarkingCircle}" ToolTip.Tip="{loc:Loc PokemonEditor_MarkingCircle}" AutomationProperties.Name="{loc:Loc PokemonEditor_MarkingCircle}" FontSize="16" HorizontalAlignment="Center" />
                                        <CheckBox Content="▲" IsChecked="{Binding MarkingTriangle}" ToolTip.Tip="{loc:Loc PokemonEditor_MarkingTriangle}" AutomationProperties.Name="{loc:Loc PokemonEditor_MarkingTriangle}" FontSize="16" HorizontalAlignment="Center" />
                                        <CheckBox Content="■" IsChecked="{Binding MarkingSquare}" ToolTip.Tip="{loc:Loc PokemonEditor_MarkingSquare}" AutomationProperties.Name="{loc:Loc PokemonEditor_MarkingSquare}" FontSize="16" HorizontalAlignment="Center" />
                                        <CheckBox Content="♥" IsChecked="{Binding MarkingHeart}" ToolTip.Tip="{loc:Loc PokemonEditor_MarkingHeart}" AutomationProperties.Name="{loc:Loc PokemonEditor_MarkingHeart}" FontSize="16" HorizontalAlignment="Center" />
                                        <CheckBox Content="★" IsChecked="{Binding MarkingStar}" ToolTip.Tip="{loc:Loc PokemonEditor_MarkingStar}" AutomationProperties.Name="{loc:Loc PokemonEditor_MarkingStar}" FontSize="16" IsVisible="{Binding HasSixMarkings}" HorizontalAlignment="Center" />
                                        <CheckBox Content="◆" IsChecked="{Binding MarkingDiamond}" ToolTip.Tip="{loc:Loc PokemonEditor_MarkingDiamond}" AutomationProperties.Name="{loc:Loc PokemonEditor_MarkingDiamond}" FontSize="16" IsVisible="{Binding HasSixMarkings}" HorizontalAlignment="Center" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Contest Tab -->
                <TabItem Classes="editor-tab" Header="{loc:Loc PokemonEditor_TabContest}" IsVisible="{Binding HasContestStats}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8" Margin="0,8,0,4">
                         <Border Classes="editor-section">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{loc:Loc PokemonEditor_ContestStats}" FontWeight="Bold" FontSize="16" Opacity="0.6" />
                                <UniformGrid Columns="2" Rows="3">
                                    <StackPanel Margin="0,0,8,12">
                                        <TextBlock Text="{loc:Loc PokemonEditor_ContestCool}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <NumericUpDown Value="{Binding ContestCool}" Minimum="0" Maximum="255" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_ContestCool}"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,12">
                                        <TextBlock Text="{loc:Loc PokemonEditor_ContestBeauty}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <NumericUpDown Value="{Binding ContestBeauty}" Minimum="0" Maximum="255" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_ContestBeauty}"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,8,12">
                                        <TextBlock Text="{loc:Loc PokemonEditor_ContestCute}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <NumericUpDown Value="{Binding ContestCute}" Minimum="0" Maximum="255" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_ContestCute}"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,12">
                                        <TextBlock Text="{loc:Loc PokemonEditor_ContestSmart}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <NumericUpDown Value="{Binding ContestSmart}" Minimum="0" Maximum="255" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_ContestSmart}"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{loc:Loc PokemonEditor_ContestTough}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <NumericUpDown Value="{Binding ContestTough}" Minimum="0" Maximum="255" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_ContestTough}"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{loc:Loc PokemonEditor_ContestSheen}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <NumericUpDown Value="{Binding ContestSheen}" Minimum="0" Maximum="255" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_ContestSheen}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Memory Tab -->
                <TabItem Classes="editor-tab" Header="{loc:Loc PokemonEditor_TabMemory}" IsVisible="{Binding HasMemories}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8" Margin="0,8,0,4">
                            <Button Content="{loc:Loc PokemonEditor_MemoryEditor}" Command="{Binding OpenMemoryEditorCommand}" HorizontalAlignment="Right" />
                            <!-- OT Memory -->
                            <Border Classes="editor-section">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Loc PokemonEditor_OtMemory}" FontWeight="Bold" Opacity="0.6" />
                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="{loc:Loc PokemonEditor_MemoryLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding OtMemory}" Minimum="0" Maximum="255" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_MemoryLabel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Intensity}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding OtMemoryIntensity}" Minimum="0" Maximum="7" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_Intensity}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Feeling}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding OtMemoryFeeling}" Minimum="0" Maximum="24" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_Feeling}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,6,0,0">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Variable}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding OtMemoryVariable}" Minimum="0" Maximum="65535" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_Variable}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- HT Memory -->
                            <Border Classes="editor-section">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Loc PokemonEditor_HtMemory}" FontWeight="Bold" Opacity="0.6" />
                                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="{loc:Loc PokemonEditor_MemoryLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding HtMemory}" Minimum="0" Maximum="255" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_MemoryLabel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Intensity}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding HtMemoryIntensity}" Minimum="0" Maximum="7" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_Intensity}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Feeling}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding HtMemoryFeeling}" Minimum="0" Maximum="24" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_Feeling}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,6,0,0">
                                            <TextBlock Text="{loc:Loc PokemonEditor_Variable}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <NumericUpDown Value="{Binding HtMemoryVariable}" Minimum="0" Maximum="65535" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc PokemonEditor_Variable}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Ribbons Tab -->
                <TabItem Classes="editor-tab" Header="{loc:Loc PokemonEditor_TabRibbons}" IsVisible="{Binding HasRibbons}">
                    <Grid RowDefinitions="Auto,*" Margin="8">
                        <!-- Header with buttons -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="{Binding RibbonCount, StringFormat='Ribbons ({0})'}"
                                       FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Content="{loc:Loc PokemonEditor_RibbonAdvanced}" Command="{Binding OpenRibbonEditorCommand}" Padding="8,4" FontSize="12" />
                                <Button Content="{loc:Loc PokemonEditor_RibbonClearAll}" Command="{Binding ClearRibbonsCommand}" Padding="8,4" FontSize="12" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Ribbon List -->
                        <Border Grid.Row="1" Classes="editor-section">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Ribbons}" Margin="0,0,0,80">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Each ribbon is a row: Icon | Name | Control -->
                                            <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,4"
                                                    Margin="0,1">
                                                <Grid ColumnDefinitions="36,*,60">
                                                    <!-- Icon -->
                                                    <Image Grid.Column="0"
                                                           Source="{Binding IconResource, Converter={StaticResource RibbonIcon}}"
                                                           Width="28" Height="28"
                                                           VerticalAlignment="Center" />

                                                    <!-- Name -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayName}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <!-- Control -->
                                                    <Panel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <!-- Boolean Ribbon: Checkbox -->
                                                        <CheckBox IsVisible="{Binding IsBooleanRibbon}"
                                                                  IsChecked="{Binding HasRibbon}"
                                                                  HorizontalAlignment="Center"
                                                                  AutomationProperties.Name="{Binding DisplayName}" />

                                                        <!-- Count Ribbon: NumericUpDown -->
                                                        <NumericUpDown IsVisible="{Binding !IsBooleanRibbon}"
                                                                       Value="{Binding RibbonCount}"
                                                                       Minimum="0"
                                                                       Maximum="{Binding MaxCount}"
                                                                       Classes="compact"
                                                                       Width="55"
                                                                       AutomationProperties.Name="{Binding DisplayName}" />
                                                    </Panel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
            </Grid>
        </Border>
</UserControl>
