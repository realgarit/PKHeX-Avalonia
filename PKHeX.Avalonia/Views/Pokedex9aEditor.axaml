<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation"
 xmlns:core="clr-namespace:PKHeX.Core;assembly=PKHeX.Core" xmlns:loc="using:PKHeX.Avalonia.Localization"
 x:Class="PKHeX.Avalonia.Views.Pokedex9aEditor" x:DataType="vm:Pokedex9aEditorViewModel" MinWidth="620" MinHeight="420">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
   <TextBlock Text="{loc:Loc Dex9a_Title}" FontSize="20" FontWeight="SemiBold" />
   <TextBlock Text="{loc:Loc Dex9a_Help}" TextWrapping="Wrap" />
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
   <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
   <WrapPanel HorizontalAlignment="Right">
    <Button Content="{loc:Loc MysteryGiftEditor_Reset}" Command="{Binding ResetCommand}" Margin="0,0,8,0" />
    <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
    <Button Name="Dex9aApply" Content="{loc:Loc Dex9a_Apply}" Command="{Binding SaveCommand}" Classes="accent" />
   </WrapPanel>
  </StackPanel>
  <TextBlock Text="{loc:Loc Dex9a_Unsupported}" IsVisible="{Binding !IsSupported}" TextWrapping="Wrap" />
  <Grid ColumnDefinitions="190,10,*" IsVisible="{Binding IsSupported}">
   <DockPanel>
    <TextBox Name="Dex9aSearch" DockPanel.Dock="Top" Text="{Binding SearchText}" PlaceholderText="{loc:Loc Pokedex4Editor_SearchSpecies}"
     AutomationProperties.Name="{loc:Loc Pokedex4Editor_SearchSpecies}" Margin="0,0,0,8" />
    <ListBox Name="Dex9aSpecies" ItemsSource="{Binding FilteredSpecies}" SelectedItem="{Binding SelectedSpecies}">
     <ListBox.ItemTemplate><DataTemplate DataType="core:ComboItem"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <ScrollViewer Name="Dex9aDetails" Grid.Column="2">
    <StackPanel Spacing="12">
     <TextBlock Text="{Binding SelectedSpecies.Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
     <Border Classes="editor-section-padded"><StackPanel Spacing="6">
      <TextBlock Text="{loc:Loc Dex9a_ScopeHelp}" TextWrapping="Wrap" />
      <WrapPanel><CheckBox Content="{loc:Loc Dex9a_WholeDex}" IsChecked="{Binding WholeDex}" Margin="0,0,12,4" />
       <CheckBox Content="{loc:Loc Dex9a_IncludeShiny}" IsChecked="{Binding IncludeShiny}" /></WrapPanel>
      <WrapPanel>
       <Button Content="{loc:Loc Dex9a_ActionSeenNone}" Command="{Binding BulkCommand}" CommandParameter="SeenNone" Margin="0,0,6,4" />
       <Button Content="{loc:Loc Dex9a_ActionSeenAll}" Command="{Binding BulkCommand}" CommandParameter="SeenAll" Margin="0,0,6,4" />
       <Button Content="{loc:Loc Dex9a_ActionCaughtNone}" Command="{Binding BulkCommand}" CommandParameter="CaughtNone" Margin="0,0,6,4" />
       <Button Content="{loc:Loc Dex9a_ActionCaughtAll}" Command="{Binding BulkCommand}" CommandParameter="CaughtAll" Margin="0,0,6,4" />
       <Button Content="{loc:Loc Dex9a_ActionComplete}" Command="{Binding BulkCommand}" CommandParameter="Complete" Margin="0,0,6,4" />
       <Button Content="{loc:Loc Dex9a_Undo}" Command="{Binding UndoCommand}" Margin="0,0,6,4" />
      </WrapPanel>
     </StackPanel></Border>
     <Border Classes="editor-section-padded"><StackPanel Spacing="6">
      <TextBlock Text="{loc:Loc Dex9a_Forms}" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,75,75,75"><TextBlock Grid.Column="1" Text="{loc:Loc Pokedex4Editor_Caught}" TextWrapping="Wrap" />
       <TextBlock Grid.Column="2" Text="{loc:Loc Pokedex4Editor_Seen}" TextWrapping="Wrap" /><TextBlock Grid.Column="3" Text="{loc:Loc PokedexGen9Editor_Shiny}" TextWrapping="Wrap" /></Grid>
      <ItemsControl ItemsSource="{Binding Forms}"><ItemsControl.ItemTemplate><DataTemplate DataType="vm:Dex9aFormRow">
       <Grid ColumnDefinitions="*,75,75,75" Margin="0,2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <CheckBox Grid.Column="1" IsChecked="{Binding Caught}" AutomationProperties.Name="{Binding CaughtAutomationName}" />
        <CheckBox Grid.Column="2" IsChecked="{Binding Seen}" AutomationProperties.Name="{Binding SeenAutomationName}" />
        <CheckBox Grid.Column="3" IsChecked="{Binding Shiny}" AutomationProperties.Name="{Binding ShinyAutomationName}" />
       </Grid>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></Border>
     <Border Classes="editor-section-padded"><StackPanel Spacing="6"><TextBlock Text="{loc:Loc Dex9a_Flags}" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Flags}"><ItemsControl.ItemTemplate><DataTemplate DataType="vm:Dex9aBoolRow"><CheckBox IsChecked="{Binding Value}"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></Border>
     <Border Classes="editor-section-padded"><StackPanel Spacing="6"><TextBlock Text="{loc:Loc Dex9a_Display}" FontWeight="SemiBold" />
      <TextBlock Text="{loc:Loc Dex9a_DisplayedForm}" /><ComboBox Name="Dex9aDisplayForm" ItemsSource="{Binding DisplayForms}" SelectedValueBinding="{Binding Value}" SelectedValue="{Binding DisplayForm}" AutomationProperties.Name="{loc:Loc Dex9a_DisplayedForm}">
       <ComboBox.ItemTemplate><DataTemplate DataType="core:ComboItem"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock Text="{loc:Loc Dex9a_DisplayedGender}" /><ComboBox Name="Dex9aDisplayGender" ItemsSource="{Binding DisplayGenders}" SelectedValueBinding="{Binding Value}" SelectedValue="{Binding DisplayGender}" AutomationProperties.Name="{loc:Loc Dex9a_DisplayedGender}">
       <ComboBox.ItemTemplate><DataTemplate DataType="core:ComboItem"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <CheckBox Content="{loc:Loc Dex9a_DisplayedShiny}" IsChecked="{Binding DisplayShiny}" />
      <CheckBox Content="{loc:Loc Dex9a_New}" IsChecked="{Binding IsNew}" />
     </StackPanel></Border>
     <Border Classes="editor-section-padded"><StackPanel Spacing="6"><TextBlock Text="{loc:Loc Dex9a_Languages}" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Languages}"><ItemsControl.ItemTemplate><DataTemplate DataType="vm:Dex9aBoolRow"><CheckBox IsChecked="{Binding Value}"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</UserControl>
