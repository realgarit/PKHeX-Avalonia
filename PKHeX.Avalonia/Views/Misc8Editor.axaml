<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation" xmlns:loc="using:PKHeX.Avalonia.Localization" x:Class="PKHeX.Avalonia.Views.Misc8Editor" x:DataType="vm:Misc8EditorViewModel">
  <Design.DataContext>
    <vm:Misc8EditorViewModel />
  </Design.DataContext>
  <Border Classes="view-container">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid Grid.Row="0" Classes="save-editor-header" ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{loc:Loc TrainerEditor_TrainerInfo}" Classes="view-title" />
          <TextBlock Text="{loc:Loc LgpeTrainer_Staging}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="{loc:Loc TrainerEditor_ApplyChanges}" Command="{Binding SaveCommand}" Classes="accent" MinWidth="100" HorizontalAlignment="Right" HorizontalContentAlignment="Center" />
      </Grid>
      <TabControl Name="Trainer8Sections" Grid.Row="1" Classes="compact-editor-tabs">
        <TabControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </TabControl.ItemsPanel>
        <TabItem Classes="editor-tab" Header="{loc:Loc TrainerZA_Overview}">
          <ScrollViewer>
            <StackPanel Spacing="8" Margin="8">
              <TextBlock Text="{loc:Loc TrainerEditor_TrainerName}" />
              <TextBox Text="{Binding TrainerName}" AutomationProperties.Name="{loc:Loc TrainerEditor_TrainerName}" />
              <TextBlock Text="{loc:Loc TrainerEditor_Gender}" />
              <ComboBox ItemsSource="{Binding Genders}" SelectedValue="{Binding Gender}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Text}" AutomationProperties.Name="{loc:Loc TrainerEditor_Gender}" />
              <TextBlock Text="{loc:Loc TrainerEditor_Language}" />
              <ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding Language}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Text}" AutomationProperties.Name="{loc:Loc TrainerEditor_Language}" />
              <TextBlock Text="{loc:Loc TrainerEditor_Badges}" />
              <NumericUpDown Value="{Binding BadgeCount}" Minimum="0" Maximum="255" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc TrainerEditor_Badges}" />
              <TextBlock Text="{loc:Loc TrainerEditor_Money}" />
              <NumericUpDown Value="{Binding Money}" Minimum="0" Maximum="4294967295" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc TrainerEditor_Money}" />
              <TextBlock Text="{loc:Loc TrainerEditor_Tid}" />
              <NumericUpDown Value="{Binding DisplayTid}" Minimum="0" Maximum="999999" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc TrainerEditor_Tid}" />
              <TextBlock Text="{loc:Loc TrainerEditor_Sid}" />
              <NumericUpDown Value="{Binding DisplaySid}" Minimum="0" Maximum="4294" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc TrainerEditor_Sid}" />
              <TextBlock Text="{loc:Loc Trainer8_CardName}" />
              <TextBox Text="{Binding LeagueCardName}" AutomationProperties.Name="{loc:Loc Trainer8_CardName}" />
              <TextBlock Text="{loc:Loc Trainer8_Uniform}" />
              <TextBox Text="{Binding UniformNumber}" AutomationProperties.Name="{loc:Loc Trainer8_Uniform}" />
              <TextBlock Text="{loc:Loc Trainer8_LeagueId}" />
              <NumericUpDown Value="{Binding LeagueTrainerId}" Minimum="0" Maximum="2147483647" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc Trainer8_LeagueId}" />
              <TextBlock Text="{loc:Loc Trainer8_RotoRally}" />
              <NumericUpDown Value="{Binding RotoRallyScore}" Minimum="0" Maximum="2147483647" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc Trainer8_RotoRally}" />
              <TextBlock Text="{loc:Loc Misc8Editor_Watts}" />
              <NumericUpDown Value="{Binding Watts}" Minimum="0" Maximum="4294967295" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc Misc8Editor_Watts}" />
              <TextBlock Text="{loc:Loc Misc8Editor_Bp}" />
              <NumericUpDown Value="{Binding Bp}" Minimum="0" Maximum="65535" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc Misc8Editor_Bp}" />
              <TextBlock Text="{loc:Loc TrainerEditor_Hours}" />
              <NumericUpDown Value="{Binding PlayedHours}" Minimum="0" Maximum="65535" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc TrainerEditor_Hours}" />
              <TextBlock Text="{loc:Loc TrainerEditor_Minutes}" />
              <NumericUpDown Value="{Binding PlayedMinutes}" Minimum="0" Maximum="255" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc TrainerEditor_Minutes}" />
              <TextBlock Text="{loc:Loc TrainerEditor_Seconds}" />
              <NumericUpDown Value="{Binding PlayedSeconds}" Minimum="0" Maximum="255" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc TrainerEditor_Seconds}" />
              <TextBlock Text="{loc:Loc Trainer7_Started}" />
              <DatePicker SelectedDate="{Binding StartedDate}" MinYear="0001-01-01T00:00:00+00:00" MaxYear="9998-12-31T00:00:00+00:00" AutomationProperties.Name="{loc:Loc Trainer7_Started}" />
              <TextBlock Text="{loc:Loc Trainer7_LastSaved}" />
              <DatePicker SelectedDate="{Binding LastSavedDate}" MinYear="1900-01-01T00:00:00+00:00" MaxYear="2100-12-31T00:00:00+00:00" AutomationProperties.Name="{loc:Loc Trainer7_LastSaved}" />
              <TimePicker SelectedTime="{Binding LastSavedTime}" AutomationProperties.Name="{loc:Loc Trainer7_LastSaved}" />
              <TextBlock Text="{loc:Loc Trainer7_Statistics}" />
              <ComboBox ItemsSource="{Binding TrainerRecords}" SelectedItem="{Binding SelectedRecord}" DisplayMemberBinding="{Binding Name}" AutomationProperties.Name="{loc:Loc Trainer7_Statistics}" />
              <ContentControl Content="{Binding SelectedRecord}">
                <ContentControl.ContentTemplate>
                  <DataTemplate DataType="vm:SwshTrainerRecordViewModel">
                    <NumericUpDown Value="{Binding Value}" Minimum="{Binding DisplayMinimum}" Maximum="{Binding DisplayMaximum}" ShowButtonSpinner="False" AutomationProperties.Name="{Binding Name}" />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Classes="editor-tab" Header="{loc:Loc TrainerZA_MapMisc}">
          <ScrollViewer>
            <StackPanel Spacing="8" Margin="8">
              <TextBlock Text="{loc:Loc Trainer7_MapId}" />
              <NumericUpDown Value="{Binding MapId}" Minimum="0" Maximum="18446744073709551615" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc Trainer7_MapId}" />
              <TextBlock Text="{loc:Loc TrainerEditor_CoordX}" />
              <TextBox Text="{Binding XText}" AutomationProperties.Name="{loc:Loc TrainerEditor_CoordX}" />
              <TextBlock Text="{loc:Loc TrainerEditor_CoordY}" />
              <TextBox Text="{Binding YText}" AutomationProperties.Name="{loc:Loc TrainerEditor_CoordY}" />
              <TextBlock Text="{loc:Loc TrainerEditor_CoordZ}" />
              <TextBox Text="{Binding ZText}" AutomationProperties.Name="{loc:Loc TrainerEditor_CoordZ}" />
              <TextBlock Text="{loc:Loc Trainer8_ScaleX}" />
              <TextBox Text="{Binding SXText}" AutomationProperties.Name="{loc:Loc Trainer8_ScaleX}" />
              <TextBlock Text="{loc:Loc Trainer8_ScaleY}" />
              <TextBox Text="{Binding SYText}" AutomationProperties.Name="{loc:Loc Trainer8_ScaleY}" />
              <TextBlock Text="{loc:Loc Trainer8_ScaleZ}" />
              <TextBox Text="{Binding SZText}" AutomationProperties.Name="{loc:Loc Trainer8_ScaleZ}" />
              <TextBlock Text="{loc:Loc Trainer7_Rotation}" />
              <NumericUpDown Value="{Binding Rotation}" Minimum="-360" Maximum="360" ShowButtonSpinner="False" AutomationProperties.Name="{loc:Loc Trainer7_Rotation}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Classes="editor-tab" Header="{loc:Loc Trainer7_Appearance}">
          <ScrollViewer>
            <StackPanel Spacing="8" Margin="8">
              <TextBlock Text="{loc:Loc Trainer7_Skin}" />
              <ComboBox ItemsSource="{Binding SkinColors}" SelectedValue="{Binding SkinColor}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Text}" AutomationProperties.Name="{loc:Loc Trainer7_Skin}" />
              <Button Content="{loc:Loc Trainer8_ActionAppearance}" Command="{Binding ResetAppearanceCommand}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Classes="editor-tab" Header="{loc:Loc Misc8Editor_BattleTower}">
          <ScrollViewer>
            <StackPanel Spacing="8" Margin="0,4,0,0">
              <!-- Currency -->
              <Border Classes="editor-section">
                <StackPanel Spacing="8">
                  <TextBlock Text="{loc:Loc Misc8Editor_Currency}" FontWeight="SemiBold" Opacity="0.6" />
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,8,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Misc8Editor_Watts}" VerticalAlignment="Center" Width="60" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Watts}" Minimum="0" Maximum="4294967295" ShowButtonSpinner="False" />
                    <Button Grid.Row="0" Grid.Column="2" Content="{loc:Loc Misc8Editor_Max}" Command="{Binding MaxWattsCommand}" Margin="8,0,0,0" Padding="8,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Misc8Editor_Bp}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Bp}" Minimum="0" Maximum="9999" ShowButtonSpinner="False" />
                    <Button Grid.Row="2" Grid.Column="2" Content="{loc:Loc Misc8Editor_Max}" Command="{Binding MaxBPCommand}" Margin="8,0,0,0" Padding="8,4" />
                  </Grid>
                </StackPanel>
              </Border>
              <!-- Battle Tower -->
              <Border Classes="editor-section">
                <StackPanel Spacing="8">
                  <TextBlock Text="{loc:Loc Misc8Editor_BattleTower}" FontWeight="SemiBold" Opacity="0.6" />
                  <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,8,Auto,8,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc Misc8Editor_Wins}" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc Misc8Editor_Streak}" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Misc8Editor_Singles}" VerticalAlignment="Center" Width="80" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SinglesWins}" Minimum="0" Maximum="4294967295" ShowButtonSpinner="False" Margin="0,0,8,0" AutomationProperties.Name="Singles Wins" />
                    <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding SinglesStreak}" Minimum="0" Maximum="65535" ShowButtonSpinner="False" AutomationProperties.Name="Singles Streak" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Misc8Editor_Doubles}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding DoublesWins}" Minimum="0" Maximum="4294967295" ShowButtonSpinner="False" Margin="0,0,8,0" AutomationProperties.Name="Doubles Wins" />
                    <NumericUpDown Grid.Row="4" Grid.Column="2" Value="{Binding DoublesStreak}" Minimum="0" Maximum="65535" ShowButtonSpinner="False" AutomationProperties.Name="Doubles Streak" />
                  </Grid>
                </StackPanel>
              </Border>
              <!-- Battle Teams lock -->
              <Border Classes="editor-section">
                  <StackPanel Spacing="8">
                      <TextBlock Text="{loc:Loc Trainer_BattleTeams}" FontWeight="SemiBold" Opacity="0.6" />
                      <TextBlock Text="{loc:Loc Trainer_BattleLockLocked}" IsVisible="{Binding IsBattleTeamLocked}" TextWrapping="Wrap" />
                      <TextBlock Text="{loc:Loc Trainer_BattleLockUnlocked}" IsVisible="{Binding !IsBattleTeamLocked}" TextWrapping="Wrap" />
                      <TextBlock Text="{loc:Loc Trainer_BattleLockHelp}" TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
                      <WrapPanel>
                          <Button Content="{loc:Loc Trainer_UnlockBattleTeams}" Command="{Binding UnlockBattleTeamsCommand}" Margin="0,0,8,4" />
                          <Button Content="{loc:Loc Menu_Options_Undo}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="0,0,8,4" />
                      </WrapPanel>
                  </StackPanel>
              </Border>
              <!-- Unlocks -->
              <Border Classes="editor-section">
                <StackPanel Spacing="8">
                  <TextBlock Text="{loc:Loc Misc8Editor_Unlocks}" FontWeight="SemiBold" Opacity="0.6" />
                  <WrapPanel>
                    <Button Content="{loc:Loc Misc8Editor_UnlockAllFashionLegal}" Command="{Binding UnlockAllFashionCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:Loc Misc8Editor_CollectAllDiglett}" Command="{Binding CollectAllDiglettCommand}" IsVisible="{Binding IsIoA}" Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel HorizontalAlignment="Right">
          <Button Content="{loc:Loc Menu_Options_Undo}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="0,0,8,0" />
          <Button Content="{loc:Loc TrainerEditor_Reset}" Command="{Binding ResetCommand}" />
        </WrapPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>