<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation"
             xmlns:loc="using:PKHeX.Avalonia.Localization"
             x:Class="PKHeX.Avalonia.Views.Roamer6Editor"
             x:DataType="vm:Roamer6EditorViewModel">

    <Design.DataContext>
        <vm:Roamer6EditorViewModel />
    </Design.DataContext>

    <!-- Three values: one header line with the commit action, then a tight label/value form. -->
    <Border Classes="view-container">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="{DynamicResource UiDensitySectionHeaderMargin}">
                <TextBlock Text="{loc:Loc Roamer6Editor_Title}" Classes="view-title" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="{loc:Loc Common_Save}" Command="{Binding SaveCommand}" Classes="accent" MinWidth="88" />
            </Grid>

            <Border Classes="editor-section-padded">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                    <TextBlock Grid.Row="0" Text="{loc:Loc Roamer6Editor_Species}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding SpeciesList}"
                              SelectedIndex="{Binding SelectedSpeciesIndex}"
                              MinWidth="180" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{loc:Loc Roamer6Editor_Species}" />

                    <TextBlock Grid.Row="1" Text="{loc:Loc Roamer6Editor_State}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding RoamStates}"
                              SelectedIndex="{Binding RoamStateIndex}"
                              MinWidth="180" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{loc:Loc Roamer6Editor_State}" />

                    <TextBlock Grid.Row="2" Text="{loc:Loc Roamer6Editor_Encountered}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                   Value="{Binding TimesEncountered}"
                                   Minimum="0" Maximum="255" Width="128"
                                   HorizontalAlignment="Left"
                                   AutomationProperties.Name="{loc:Loc Roamer6Editor_Encountered}" />
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
