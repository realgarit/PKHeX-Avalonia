<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation"
             xmlns:loc="using:PKHeX.Avalonia.Localization"
             x:Class="PKHeX.Avalonia.Views.FashionEditorView"
             x:DataType="vm:FashionEditorViewModel"
             MinWidth="450" MinHeight="400">
    <DockPanel Classes="tool-surface" Margin="12">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Classes="save-editor-header">
            <StackPanel Grid.Column="0" Classes="tool-header-stack">
                <TextBlock Text="{loc:Loc FashionEditorView_Title}" Classes="view-title" />
                <TextBlock Text="{Binding GameInfo}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{loc:Loc FashionEditorView_UnlockAll}" Command="{Binding UnlockAllCommand}" Margin="2" Padding="10,5" />
                <Button Content="{loc:Loc FashionEditorView_UnlockAllLegal}" Command="{Binding UnlockAllLegalCommand}" Margin="2" Padding="10,5" />
                <Button Content="{loc:Loc FashionEditorView_ResetToDefault}" Command="{Binding ResetCommand}" Margin="2" Padding="10,5" />
                <Button Content="{loc:Loc FashionEditorView_ClearAll}" Command="{Binding ClearCommand}" Margin="2" Padding="10,5" />
            </WrapPanel>
        </Grid>

        <!-- Not Supported Message -->
        <TextBlock IsVisible="{Binding !IsSupported}" Text="{loc:Loc FashionEditorView_NotSupported}"
                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                   FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Fashion Content -->
        <DockPanel IsVisible="{Binding IsSupported}">
            <!-- Regions List -->
            <ItemsControl ItemsSource="{Binding Regions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:FashionRegionViewModel">
                        <Border Classes="editor-section-padded" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </DockPanel>
</UserControl>
