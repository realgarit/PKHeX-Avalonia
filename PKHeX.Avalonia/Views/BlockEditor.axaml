<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PKHeX.Presentation.ViewModels;assembly=PKHeX.Presentation"
             xmlns:loc="using:PKHeX.Avalonia.Localization"
             x:Class="PKHeX.Avalonia.Views.BlockEditor"
             x:DataType="vm:BlockEditorViewModel"
             MinWidth="620" MinHeight="440">
    <Border Classes="view-container">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
            <TextBlock Classes="view-title" Text="{loc:Loc BlockEditor_Title}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="StatusLine" Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource ThemeTextMutedBrush}" AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <TextBlock x:Name="UnsupportedText" DockPanel.Dock="Top" Text="{loc:Loc BlockEditor_Unsupported}" TextWrapping="Wrap"
                   IsVisible="{Binding !IsSupported}" Margin="0,0,0,6" />

        <TabControl x:Name="Tabs" Classes="compact-editor-tabs">
            <TabItem x:Name="DumpTab" Header="{loc:Loc BlockEditor_TabDump}">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,4,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText}" AutomationProperties.Name="{loc:Loc BlockEditor_SearchWatermark}"
                                 PlaceholderText="{loc:Loc BlockEditor_SearchWatermark}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding BlockCountText}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemeTextMutedBrush}" />
                    </Grid>

                    <WrapPanel x:Name="DumpActions" Grid.Row="1" Margin="0,0,0,6">
                        <Button Content="{loc:Loc BlockEditor_ExportButton}" Command="{Binding ExportBlockCommand}" Margin="0,0,6,6" />
                        <Button Content="{loc:Loc BlockEditor_ImportButton}" Command="{Binding ImportBlockCommand}" Margin="0,0,12,6" />
                        <Button Content="{loc:Loc BlockEditor_ExportAllFolder}" Command="{Binding ExportAllToFolderCommand}" Margin="0,0,6,6" />
                        <Button Content="{loc:Loc BlockEditor_ExportAllFile}" Command="{Binding ExportAllToFileCommand}" Margin="0,0,6,6" />
                        <Button Content="{loc:Loc BlockEditor_ImportFolder}" Command="{Binding ImportFromFolderCommand}" Margin="0,0,12,6" />
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasExportOptions}" Margin="0,0,0,6">
                            <CheckBox Content="{loc:Loc BlockEditor_OptionDataOnly}" IsChecked="{Binding ExportDataOnly}" />
                            <CheckBox Content="{loc:Loc BlockEditor_OptionKey}" IsChecked="{Binding ExportKeys}" />
                            <CheckBox Content="{loc:Loc BlockEditor_OptionTypeInfo}" IsChecked="{Binding ExportTypeInfo}" />
                            <CheckBox Content="{loc:Loc BlockEditor_OptionHeader}" IsChecked="{Binding ExportFakeHeader}" />
                        </StackPanel>
                    </WrapPanel>

                    <Grid Grid.Row="2" ColumnDefinitions="2*,Auto,*">
                        <Border Classes="database-results-pane">
                            <DataGrid x:Name="BlockGrid" Classes="save-grid" ItemsSource="{Binding FilteredBlocks}"
                                      SelectedItem="{Binding SelectedBlock}"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      AutomationProperties.Name="{loc:Loc BlockEditor_Title}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc BlockEditor_KeyHeader}" Binding="{Binding Key}" Width="112" />
                                    <DataGridTextColumn Header="{loc:Loc BlockEditor_NameHeader}" Binding="{Binding Name}" Width="*" MinWidth="110" />
                                    <DataGridTextColumn Header="{loc:Loc BlockEditor_TypeHeader}" Binding="{Binding TypeText}" Width="110" />
                                    <DataGridTextColumn Header="{loc:Loc BlockEditor_SizeHeader}" Binding="{Binding SizeString}" Width="80" />
                                    <DataGridTextColumn Header="{loc:Loc BlockEditor_ValueHeader}" Binding="{Binding ValueText}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <GridSplitter Grid.Column="1" Classes="pane-splitter" />

                        <Grid x:Name="DetailPane" Grid.Column="2" RowDefinitions="Auto,*,Auto,2*" MinWidth="200" Margin="8,0,0,0">
                            <TextBlock Grid.Row="0" Text="{loc:Loc BlockEditor_Details}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <!-- The metadata scrolls with the hex preview so a short window or tall CJK text never pushes the preview out of the pane. -->
                            <ScrollViewer x:Name="DetailScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding HasSelection}">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Text="{loc:Loc BlockEditor_KeyHeader}" Classes="muted" Margin="0,0,8,2" />
                                <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailKey}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="{loc:Loc BlockEditor_NameHeader}" Classes="muted" Margin="0,0,8,2" />
                                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailName}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="{loc:Loc BlockEditor_TypeHeader}" Classes="muted" Margin="0,0,8,2" />
                                <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailType}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="{loc:Loc BlockEditor_SubTypeLabel}" Classes="muted" Margin="0,0,8,2" IsVisible="{Binding HasSubType}" />
                                <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailSubType}" IsVisible="{Binding HasSubType}" />
                                <TextBlock Grid.Row="4" Text="{loc:Loc BlockEditor_SizeHeader}" Classes="muted" Margin="0,0,8,2" />
                                <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailLength}" />
                                <TextBlock Grid.Row="5" Text="{loc:Loc BlockEditor_OffsetHeader}" Classes="muted" Margin="0,0,8,2" IsVisible="{Binding HasOffset}" />
                                <SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DetailOffset}" IsVisible="{Binding HasOffset}" />
                                <TextBlock Grid.Row="6" Text="{loc:Loc BlockEditor_ValueHeader}" Classes="muted" Margin="0,0,8,2" IsVisible="{Binding HasValue}" />
                                <SelectableTextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DetailValue}" TextWrapping="Wrap" IsVisible="{Binding HasValue}" />
                            </Grid>
                            </ScrollViewer>
                            <TextBlock Grid.Row="2" Text="{Binding HexPreviewNote}" TextWrapping="Wrap" Classes="muted"
                                       IsVisible="{Binding HasHexPreviewNote}" Margin="0,4,0,4" />
                            <Border Grid.Row="3" Classes="database-results-pane" Margin="0,4,0,0">
                                <ScrollViewer x:Name="HexScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              AutomationProperties.Name="{loc:Loc BlockEditor_HexPreview}">
                                    <SelectableTextBlock x:Name="HexText" Text="{Binding HexPreviewText}"
                                                         FontFamily="Consolas, Menlo, monospace" FontSize="11" Margin="4" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="CompareTab" Header="{loc:Loc BlockEditor_TabCompare}">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,4,0,0">
                    <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                        <Button Content="{loc:Loc BlockEditor_CompareCurrent}" Command="{Binding CompareWithFileCommand}" Margin="0,0,6,6" />
                        <Button Content="{loc:Loc BlockEditor_CompareFiles}" Command="{Binding CompareFilesCommand}" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Text="{Binding CompareSummary}" TextWrapping="Wrap" Margin="0,0,0,6"
                               AutomationProperties.LiveSetting="Polite" />
                    <Border Grid.Row="2" Classes="database-results-pane">
                        <DataGrid x:Name="CompareGrid" Classes="save-grid" ItemsSource="{Binding CompareResults}"
                                  IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                                  AutoGenerateColumns="False" HeadersVisibility="Column"
                                  AutomationProperties.Name="{loc:Loc BlockEditor_TabCompare}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc BlockEditor_ChangeHeader}" Binding="{Binding KindText}" Width="120" />
                                <DataGridTextColumn Header="{loc:Loc BlockEditor_KeyHeader}" Binding="{Binding Key}" Width="112" />
                                <DataGridTextColumn Header="{loc:Loc BlockEditor_NameHeader}" Binding="{Binding Name}" Width="*" MinWidth="110" />
                                <DataGridTextColumn Header="{loc:Loc BlockEditor_DetailsHeader}" Binding="{Binding DetailText}" Width="2*" MinWidth="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
    </Border>
</UserControl>
