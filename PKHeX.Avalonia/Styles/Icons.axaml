<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shared vector icon set (issue #245).

        Provenance: every geometry below is original work drawn for PKHeX-Avalonia on a 16 x 16
        DIP grid from basic shapes (lines, arcs and polygons). No glyph is copied or traced from
        upstream PKHeX artwork, an icon font or another icon library. See docs/icons.md.

        Grid contract:
          - 16 x 16 DIP design box; shapes stay inside a 1 DIP safe margin (1..15).
          - Solid fill only (PathIcon fills its geometry); line-like glyphs use 1.5-2 DIP bars so
            every icon has the same optical weight at 16 DIP and scales cleanly at 125/150/200 %.
          - Colour never lives in the geometry. PathIcon takes Foreground from the central
            state styles below, which read the semantic theme tokens, so the HighContrast,
            Light and Dark variants all apply without per-icon work.

        Use: <PathIcon Data="{StaticResource Icon.Search}" /> inside a Button with the
        "icon-action" class, plus ToolTip.Tip and AutomationProperties.Name from {loc:Loc ...}.
        Tests/PKHeX.Avalonia.Tests/IconSystemTests.cs keeps this inventory and the no-emoji
        rule for .axaml views.
    -->
    <Styles.Resources>
        <!-- Navigation -->
        <StreamGeometry x:Key="Icon.ChevronLeft">M10.3,2.3 L11.7,3.7 L7.4,8 L11.7,12.3 L10.3,13.7 L4.6,8 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.ChevronRight">M5.7,2.3 L4.3,3.7 L8.6,8 L4.3,12.3 L5.7,13.7 L11.4,8 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.ChevronUp">M2.3,10.3 L3.7,11.7 L8,7.4 L12.3,11.7 L13.7,10.3 L8,4.6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.ChevronDown">M2.3,5.7 L3.7,4.3 L8,8.6 L12.3,4.3 L13.7,5.7 L8,11.4 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.ArrowRight">M2,7 H10.2 L7.3,4.1 L8.7,2.7 L14,8 L8.7,13.3 L7.3,11.9 L10.2,9 H2 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.ArrowLeft">M14,7 H5.8 L8.7,4.1 L7.3,2.7 L2,8 L7.3,13.3 L8.7,11.9 L5.8,9 H14 Z</StreamGeometry>

        <!-- Actions -->
        <StreamGeometry x:Key="Icon.Close">M3.4,2 L8,6.6 L12.6,2 L14,3.4 L9.4,8 L14,12.6 L12.6,14 L8,9.4 L3.4,14 L2,12.6 L6.6,8 L2,3.4 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Check">M6.2,12.6 L1.8,8.2 L3.2,6.8 L6.2,9.8 L12.8,3.2 L14.2,4.6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Search">F1 M7,1.5 A5.5,5.5 0 1 1 7,12.5 A5.5,5.5 0 1 1 7,1.5 Z M7,3.5 A3.5,3.5 0 1 0 7,10.5 A3.5,3.5 0 1 0 7,3.5 Z M11.2,9.8 L14.7,13.3 L13.3,14.7 L9.8,11.2 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Reset">F1 M8,3 A5.5,5.5 0 1 1 2.5,8.5 L4.2,8.5 A3.8,3.8 0 1 0 8,4.7 Z M8,1 L8,6.7 L5.2,3.85 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Filter">M1.5,2.5 H14.5 L9.5,8.5 V13.5 L6.5,12 V8.5 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Folder">M1.5,3.5 H6 L7.5,5 H14.5 V13 H1.5 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Tool">M13.9,4.3 L11.5,6.7 L9.3,6.7 L9.3,4.5 L11.7,2.1 C9.9,1.4 7.8,1.8 6.6,3.3 C5.5,4.5 5.3,6.2 5.8,7.6 L1.6,11.8 C1,12.4 1,13.4 1.6,14 L2,14.4 C2.6,15 3.6,15 4.2,14.4 L8.4,10.2 C9.8,10.7 11.5,10.5 12.7,9.4 C14.2,8.2 14.6,6.1 13.9,4.3 Z</StreamGeometry>

        <!-- Pokemon states and markings -->
        <StreamGeometry x:Key="Icon.Star">M8,1.3 L9.7,5.95 L14.66,6.14 L10.76,9.2 L12.11,13.96 L8,11.2 L3.89,13.96 L5.24,9.2 L1.34,6.14 L6.3,5.95 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Heart">M8,14 L2.2,8.3 C0.6,6.7 0.7,4.1 2.4,2.8 C4,1.6 6.3,1.9 7.6,3.5 L8,4 L8.4,3.5 C9.7,1.9 12,1.6 13.6,2.8 C15.3,4.1 15.4,6.7 13.8,8.3 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Circle">M8,2 A6,6 0 1 1 8,14 A6,6 0 1 1 8,2 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Triangle">M8,2 L14.5,13.5 H1.5 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Square">M2.5,2.5 H13.5 V13.5 H2.5 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Diamond">M8,1.5 L14.5,8 L8,14.5 L1.5,8 Z</StreamGeometry>

        <!-- Inventory pouches -->
        <StreamGeometry x:Key="Icon.Pouch.Items">F0 M5.5,4.5 V3.5 C5.5,2.1 6.6,1 8,1 C9.4,1 10.5,2.1 10.5,3.5 V4.5 H13.5 L14.5,14.5 H1.5 L2.5,4.5 Z M7,4.5 H9 V3.5 C9,2.9 8.6,2.5 8,2.5 C7.4,2.5 7,2.9 7,3.5 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.KeyItems">F0 M4.5,4.5 A3.5,3.5 0 1 1 4.5,11.5 A3.5,3.5 0 1 1 4.5,4.5 Z M4.5,6.5 A1.5,1.5 0 1 0 4.5,9.5 A1.5,1.5 0 1 0 4.5,6.5 Z M7.8,7 H15 V9 H14.5 V11.5 H13 V9 H12 V11 H10.5 V9 H7.8 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.TMHMs">F0 M8,1.5 A6.5,6.5 0 1 1 8,14.5 A6.5,6.5 0 1 1 8,1.5 Z M8,6 A2,2 0 1 0 8,10 A2,2 0 1 0 8,6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.Medicine">M6,1.5 H10 V6 H14.5 V10 H10 V14.5 H6 V10 H1.5 V6 H6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.Berries">F1 M8,5 A5,5 0 1 1 8,15 A5,5 0 1 1 8,5 Z M8,5.2 C8,3 9.5,1.5 12,1.5 C12,3.5 10.5,5 8.6,5.2 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.Balls">M1.5,7.2 A6.5,6.5 0 0 1 14.5,7.2 Z M1.5,8.8 A6.5,6.5 0 0 0 14.5,8.8 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.BattleItems">M9.5,1 L3,9 H7.5 L6.5,15 L13,7 H8.5 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.MailItems">F0 M1.5,3 H14.5 V13 H1.5 Z M3,4.5 V11.5 H13 V4.5 Z M3,4.5 L8,8 L13,4.5 V6.3 L8,9.8 L3,6.3 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.PCItems">F0 M1.5,2.5 H14.5 V11 H1.5 Z M3,4 V9.5 H13 V4 Z M6.5,11 H9.5 V12.5 H11.5 V14 H4.5 V12.5 H6.5 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.FreeSpace">M1.5,4.5 L8,1.5 L14.5,4.5 V11.5 L8,14.5 L1.5,11.5 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.Gem">M4.5,2 H11.5 L14.5,6 L8,14.5 L1.5,6 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.Candy">F1 M8,4.5 A3.5,3.5 0 1 1 8,11.5 A3.5,3.5 0 1 1 8,4.5 Z M4.8,6.6 L4.8,9.4 L1,12 L1,4 Z M11.2,6.6 L15,4 L15,12 L11.2,9.4 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Pouch.Ingredients">M2.5,13.5 C2.5,6.5 7,2 14,2 C14,9.5 9.5,13.5 2.5,13.5 Z</StreamGeometry>
    </Styles.Resources>

    <!--
        Central icon states. A PathIcon inherits nothing visual from its host button beyond these
        rules, so every icon-only action shares one normal / hover / pressed / disabled look. The
        brushes are semantic theme tokens: the HighContrast dictionary maps them to its
        white / orange high-contrast palette, so high contrast needs no separate rules here.
    -->
    <Style Selector="PathIcon.icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>
    <Style Selector="PathIcon.icon-small">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style Selector="Button.icon-action">
        <Setter Property="MinWidth" Value="{DynamicResource UiDensityControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiDensityInlineControlHeight}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon-action PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.icon-action:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.icon-action:pressed PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource CompactAccentTextBrush}" />
    </Style>
    <Style Selector="Button.icon-action:disabled PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeControlDisabledTextBrush}" />
    </Style>
    <Style Selector="Button:pressed PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource CompactAccentTextBrush}" />
    </Style>
    <Style Selector="Button:disabled PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeControlDisabledTextBrush}" />
    </Style>

    <!-- Marking toggles: the checked marking uses the primary text colour, an unchecked one stays muted. -->
    <Style Selector="CheckBox PathIcon.marking">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>
    <Style Selector="CheckBox:checked PathIcon.marking">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <!-- Pouch tab icons follow the tab's own foreground, so the selected tab's accent applies. -->
    <Style Selector="PathIcon.pouch-icon">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Shiny state badge. -->
    <Style Selector="PathIcon.shiny-badge">
        <Setter Property="Foreground" Value="{DynamicResource ThemeShinyBrush}" />
    </Style>
</Styles>
