<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PKHeX.Presentation.Models;assembly=PKHeX.Presentation"
        xmlns:services="clr-namespace:PKHeX.Avalonia.Services">

    <!-- ═══════════════════════════════════════════════════════════════════════
         PKHeX Theme Tokens
         Semantic design tokens exposed as ThemeDictionaries so the whole app can
         switch appearance at runtime (Settings > Appearance) without a restart:
           - Dark          : neutral dark Fluent palette (default)
           - Light         : neutral light Fluent palette
           - HighContrast  : retained internally for legacy accessibility settings, not exposed in
                             the product picker
         Every consumer below (and in Views) must use DynamicResource, not
         StaticResource, so brushes actually re-resolve when the variant changes.
         ═══════════════════════════════════════════════════════════════════════ -->

    <Style>
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>

                    <!-- ═══════════════════════ Dark (default) ═══════════════════════ -->
                    <ResourceDictionary x:Key="Dark">
                        <!-- Base Colors -->
                        <Color x:Key="ThemeBackgroundDeep">#101010</Color>
                        <Color x:Key="ThemeBackgroundBase">#171717</Color>
                        <Color x:Key="ThemeBackgroundCard">#202020</Color>
                        <Color x:Key="ThemeBackgroundElevated">#2A2A2A</Color>
                        <Color x:Key="ThemeBackgroundHover">#353535</Color>

                        <!-- Border Colors -->
                        <Color x:Key="ThemeBorderDefault">#3D3D3D</Color>
                        <Color x:Key="ThemeBorderMuted">#2C2C2C</Color>

                        <!-- Native control surfaces: quiet enough for long editing sessions, with
                             a slightly brighter interaction layer so focus and selection remain
                             legible without turning every field into an accent block. -->
                        <Color x:Key="ThemeControlBackground">#1C1C1C</Color>
                        <Color x:Key="ThemeControlBackgroundHover">#262626</Color>
                        <Color x:Key="ThemeControlBackgroundPressed">#313131</Color>
                        <Color x:Key="ThemeControlBorder">#4A4A4A</Color>
                        <Color x:Key="ThemeControlBorderHover">#666666</Color>
                        <Color x:Key="ThemeControlBorderFocus">#D7D7D7</Color>
                        <Color x:Key="ThemeControlFocusGlow">#D7D7D720</Color>
                        <Color x:Key="ThemeControlPopup">#1D1D1D</Color>
                        <Color x:Key="ThemeControlPopupHover">#2B2B2B</Color>
                        <Color x:Key="ThemeControlPopupSelected">#454545</Color>
                        <Color x:Key="ThemeControlDisabled">#242424</Color>
                        <Color x:Key="ThemeControlDisabledText">#777777</Color>

                        <!-- Text Colors (AA on ThemeBackgroundBase: Primary ~13:1, Secondary ~5.7:1) -->
                        <Color x:Key="ThemeTextPrimary">#F4F4F4</Color>
                        <Color x:Key="ThemeTextSecondary">#B8B8B8</Color>
                        <Color x:Key="ThemeTextMuted">#858585</Color>

                        <!-- Accent Colors - neutral graphite/silver, avoiding a branded color wash -->
                        <Color x:Key="ThemeAccentPrimary">#D7D7D7</Color>
                        <Color x:Key="ThemeAccentSecondary">#A9A9A9</Color>
                        <Color x:Key="ThemeAccentGlow">#D7D7D730</Color>

                        <!-- Semantic Colors -->
                        <Color x:Key="ThemeSuccessColor">#3FB950</Color>
                        <Color x:Key="ThemeSuccessGlow">#3FB95040</Color>
                        <Color x:Key="ThemeErrorColor">#F85149</Color>
                        <Color x:Key="ThemeErrorGlow">#F8514940</Color>
                        <Color x:Key="ThemeWarningColor">#D29922</Color>
                        <Color x:Key="ThemeWarningGlow">#D2992240</Color>
                        <Color x:Key="ThemeShinyColor">#E3350D</Color>
                        <Color x:Key="ThemeShinyGoldColor">#FFD700</Color>

                        <!-- Full-screen scrim used behind loading/searching overlays -->
                        <Color x:Key="ThemeOverlayScrim">#80000000</Color>
                        <Color x:Key="ThemeOverlayForeground">#FFFFFF</Color>

                        <!-- Brushes -->
                        <SolidColorBrush x:Key="ThemeBackgroundDeepBrush" Color="{StaticResource ThemeBackgroundDeep}" />
                        <SolidColorBrush x:Key="ThemeBackgroundBaseBrush" Color="{StaticResource ThemeBackgroundBase}" />
                        <SolidColorBrush x:Key="ThemeBackgroundCardBrush" Color="{StaticResource ThemeBackgroundCard}" />
                        <SolidColorBrush x:Key="ThemeBackgroundElevatedBrush" Color="{StaticResource ThemeBackgroundElevated}" />
                        <SolidColorBrush x:Key="ThemeBackgroundHoverBrush" Color="{StaticResource ThemeBackgroundHover}" />

                        <SolidColorBrush x:Key="ThemeBorderDefaultBrush" Color="{StaticResource ThemeBorderDefault}" />
                        <SolidColorBrush x:Key="ThemeBorderMutedBrush" Color="{StaticResource ThemeBorderMuted}" />

                        <SolidColorBrush x:Key="ThemeControlBackgroundBrush" Color="{StaticResource ThemeControlBackground}" />
                        <SolidColorBrush x:Key="ThemeControlBackgroundHoverBrush" Color="{StaticResource ThemeControlBackgroundHover}" />
                        <SolidColorBrush x:Key="ThemeControlBackgroundPressedBrush" Color="{StaticResource ThemeControlBackgroundPressed}" />
                        <SolidColorBrush x:Key="ThemeControlBorderBrush" Color="{StaticResource ThemeControlBorder}" />
                        <SolidColorBrush x:Key="ThemeControlBorderHoverBrush" Color="{StaticResource ThemeControlBorderHover}" />
                        <SolidColorBrush x:Key="ThemeControlBorderFocusBrush" Color="{StaticResource ThemeControlBorderFocus}" />
                        <SolidColorBrush x:Key="ThemeControlFocusGlowBrush" Color="{StaticResource ThemeControlFocusGlow}" />
                        <SolidColorBrush x:Key="ThemeControlPopupBrush" Color="{StaticResource ThemeControlPopup}" />
                        <SolidColorBrush x:Key="ThemeControlPopupHoverBrush" Color="{StaticResource ThemeControlPopupHover}" />
                        <SolidColorBrush x:Key="ThemeControlPopupSelectedBrush" Color="{StaticResource ThemeControlPopupSelected}" />
                        <SolidColorBrush x:Key="ThemeControlDisabledBrush" Color="{StaticResource ThemeControlDisabled}" />
                        <SolidColorBrush x:Key="ThemeControlDisabledTextBrush" Color="{StaticResource ThemeControlDisabledText}" />

                        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource ThemeTextPrimary}" />
                        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="{StaticResource ThemeTextSecondary}" />
                        <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="{StaticResource ThemeTextMuted}" />

                        <SolidColorBrush x:Key="ThemeAccentPrimaryBrush" Color="{StaticResource ThemeAccentPrimary}" />
                        <SolidColorBrush x:Key="ThemeAccentSecondaryBrush" Color="{StaticResource ThemeAccentSecondary}" />
                        <SolidColorBrush x:Key="ThemeAccentGlowBrush" Color="{StaticResource ThemeAccentGlow}" />

                        <SolidColorBrush x:Key="ThemeSuccessBrush" Color="{StaticResource ThemeSuccessColor}" />
                        <SolidColorBrush x:Key="ThemeSuccessGlowBrush" Color="{StaticResource ThemeSuccessGlow}" />
                        <SolidColorBrush x:Key="ThemeErrorBrush" Color="{StaticResource ThemeErrorColor}" />
                        <SolidColorBrush x:Key="ThemeErrorGlowBrush" Color="{StaticResource ThemeErrorGlow}" />
                        <SolidColorBrush x:Key="ThemeWarningBrush" Color="{StaticResource ThemeWarningColor}" />
                        <SolidColorBrush x:Key="ThemeWarningGlowBrush" Color="{StaticResource ThemeWarningGlow}" />
                        <SolidColorBrush x:Key="ThemeShinyBrush" Color="{StaticResource ThemeShinyColor}" />
                        <SolidColorBrush x:Key="ThemeShinyGoldBrush" Color="{StaticResource ThemeShinyGoldColor}" />

                        <SolidColorBrush x:Key="ThemeOverlayScrimBrush" Color="{StaticResource ThemeOverlayScrim}" />
                        <SolidColorBrush x:Key="ThemeOverlayForegroundBrush" Color="{StaticResource ThemeOverlayForeground}" />

                        <!-- Gradients -->
                        <LinearGradientBrush x:Key="ThemeAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#D7D7D7" Offset="0" />
                            <GradientStop Color="#F0F0F0" Offset="1" />
                        </LinearGradientBrush>

                        <LinearGradientBrush x:Key="ThemeCardGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#202020" Offset="0" />
                            <GradientStop Color="#171717" Offset="1" />
                        </LinearGradientBrush>

                        <LinearGradientBrush x:Key="ThemeHeaderGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#D7D7D720" Offset="0" />
                            <GradientStop Color="#F0F0F010" Offset="1" />
                        </LinearGradientBrush>

                        <!-- Box Shadow Effects -->
                        <BoxShadows x:Key="ThemeShadowSmall">0 1 3 0 #00000040</BoxShadows>
                        <BoxShadows x:Key="ThemeShadowMedium">0 4 12 0 #00000050</BoxShadows>
                        <BoxShadows x:Key="ThemeShadowLarge">0 8 24 0 #00000060</BoxShadows>
                        <BoxShadows x:Key="ThemeGlowAccent">0 0 16 0 #D7D7D730</BoxShadows>
                        <BoxShadows x:Key="ThemeGlowSuccess">0 0 16 0 #3FB95040</BoxShadows>
                        <BoxShadows x:Key="ThemeGlowError">0 0 16 0 #F8514940</BoxShadows>
                    </ResourceDictionary>

                    <!-- ═══════════════════════════ Light ═══════════════════════════ -->
                    <ResourceDictionary x:Key="Light">
                        <!-- Base Colors -->
                        <Color x:Key="ThemeBackgroundDeep">#F0F0F0</Color>
                        <Color x:Key="ThemeBackgroundBase">#F8F8F8</Color>
                        <Color x:Key="ThemeBackgroundCard">#FFFFFF</Color>
                        <Color x:Key="ThemeBackgroundElevated">#E9E9E9</Color>
                        <Color x:Key="ThemeBackgroundHover">#DEDEDE</Color>

                        <!-- Border Colors -->
                        <Color x:Key="ThemeBorderDefault">#C7C7C7</Color>
                        <Color x:Key="ThemeBorderMuted">#E1E1E1</Color>

                        <!-- Native control surfaces -->
                        <Color x:Key="ThemeControlBackground">#FFFFFF</Color>
                        <Color x:Key="ThemeControlBackgroundHover">#F2F2F2</Color>
                        <Color x:Key="ThemeControlBackgroundPressed">#E7E7E7</Color>
                        <Color x:Key="ThemeControlBorder">#A9A9A9</Color>
                        <Color x:Key="ThemeControlBorderHover">#777777</Color>
                        <Color x:Key="ThemeControlBorderFocus">#4B4B4B</Color>
                        <Color x:Key="ThemeControlFocusGlow">#4B4B4B22</Color>
                        <Color x:Key="ThemeControlPopup">#FFFFFF</Color>
                        <Color x:Key="ThemeControlPopupHover">#F2F2F2</Color>
                        <Color x:Key="ThemeControlPopupSelected">#DCDCDC</Color>
                        <Color x:Key="ThemeControlDisabled">#EEEEEE</Color>
                        <Color x:Key="ThemeControlDisabledText">#808080</Color>

                        <!-- Text Colors (AA on ThemeBackgroundBase/Card: Primary ~16:1, Secondary ~9:1, Muted ~4.6:1) -->
                        <Color x:Key="ThemeTextPrimary">#202020</Color>
                        <Color x:Key="ThemeTextSecondary">#535353</Color>
                        <Color x:Key="ThemeTextMuted">#707070</Color>

                        <!-- Accent Colors - neutral graphite -->
                        <Color x:Key="ThemeAccentPrimary">#4B4B4B</Color>
                        <Color x:Key="ThemeAccentSecondary">#353535</Color>
                        <Color x:Key="ThemeAccentGlow">#4B4B4B28</Color>

                        <!-- Semantic Colors - darkened from the Dark palette so they clear 4.5:1 on white -->
                        <Color x:Key="ThemeSuccessColor">#1A7F37</Color>
                        <Color x:Key="ThemeSuccessGlow">#1A7F3733</Color>
                        <Color x:Key="ThemeErrorColor">#CF222E</Color>
                        <Color x:Key="ThemeErrorGlow">#CF222E33</Color>
                        <Color x:Key="ThemeWarningColor">#9A6700</Color>
                        <Color x:Key="ThemeWarningGlow">#9A670033</Color>
                        <Color x:Key="ThemeShinyColor">#E3350D</Color>
                        <Color x:Key="ThemeShinyGoldColor">#7A5D00</Color>

                        <Color x:Key="ThemeOverlayScrim">#80000000</Color>
                        <Color x:Key="ThemeOverlayForeground">#FFFFFF</Color>

                        <!-- Brushes -->
                        <SolidColorBrush x:Key="ThemeBackgroundDeepBrush" Color="{StaticResource ThemeBackgroundDeep}" />
                        <SolidColorBrush x:Key="ThemeBackgroundBaseBrush" Color="{StaticResource ThemeBackgroundBase}" />
                        <SolidColorBrush x:Key="ThemeBackgroundCardBrush" Color="{StaticResource ThemeBackgroundCard}" />
                        <SolidColorBrush x:Key="ThemeBackgroundElevatedBrush" Color="{StaticResource ThemeBackgroundElevated}" />
                        <SolidColorBrush x:Key="ThemeBackgroundHoverBrush" Color="{StaticResource ThemeBackgroundHover}" />

                        <SolidColorBrush x:Key="ThemeBorderDefaultBrush" Color="{StaticResource ThemeBorderDefault}" />
                        <SolidColorBrush x:Key="ThemeBorderMutedBrush" Color="{StaticResource ThemeBorderMuted}" />

                        <SolidColorBrush x:Key="ThemeControlBackgroundBrush" Color="{StaticResource ThemeControlBackground}" />
                        <SolidColorBrush x:Key="ThemeControlBackgroundHoverBrush" Color="{StaticResource ThemeControlBackgroundHover}" />
                        <SolidColorBrush x:Key="ThemeControlBackgroundPressedBrush" Color="{StaticResource ThemeControlBackgroundPressed}" />
                        <SolidColorBrush x:Key="ThemeControlBorderBrush" Color="{StaticResource ThemeControlBorder}" />
                        <SolidColorBrush x:Key="ThemeControlBorderHoverBrush" Color="{StaticResource ThemeControlBorderHover}" />
                        <SolidColorBrush x:Key="ThemeControlBorderFocusBrush" Color="{StaticResource ThemeControlBorderFocus}" />
                        <SolidColorBrush x:Key="ThemeControlFocusGlowBrush" Color="{StaticResource ThemeControlFocusGlow}" />
                        <SolidColorBrush x:Key="ThemeControlPopupBrush" Color="{StaticResource ThemeControlPopup}" />
                        <SolidColorBrush x:Key="ThemeControlPopupHoverBrush" Color="{StaticResource ThemeControlPopupHover}" />
                        <SolidColorBrush x:Key="ThemeControlPopupSelectedBrush" Color="{StaticResource ThemeControlPopupSelected}" />
                        <SolidColorBrush x:Key="ThemeControlDisabledBrush" Color="{StaticResource ThemeControlDisabled}" />
                        <SolidColorBrush x:Key="ThemeControlDisabledTextBrush" Color="{StaticResource ThemeControlDisabledText}" />

                        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource ThemeTextPrimary}" />
                        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="{StaticResource ThemeTextSecondary}" />
                        <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="{StaticResource ThemeTextMuted}" />

                        <SolidColorBrush x:Key="ThemeAccentPrimaryBrush" Color="{StaticResource ThemeAccentPrimary}" />
                        <SolidColorBrush x:Key="ThemeAccentSecondaryBrush" Color="{StaticResource ThemeAccentSecondary}" />
                        <SolidColorBrush x:Key="ThemeAccentGlowBrush" Color="{StaticResource ThemeAccentGlow}" />

                        <SolidColorBrush x:Key="ThemeSuccessBrush" Color="{StaticResource ThemeSuccessColor}" />
                        <SolidColorBrush x:Key="ThemeSuccessGlowBrush" Color="{StaticResource ThemeSuccessGlow}" />
                        <SolidColorBrush x:Key="ThemeErrorBrush" Color="{StaticResource ThemeErrorColor}" />
                        <SolidColorBrush x:Key="ThemeErrorGlowBrush" Color="{StaticResource ThemeErrorGlow}" />
                        <SolidColorBrush x:Key="ThemeWarningBrush" Color="{StaticResource ThemeWarningColor}" />
                        <SolidColorBrush x:Key="ThemeWarningGlowBrush" Color="{StaticResource ThemeWarningGlow}" />
                        <SolidColorBrush x:Key="ThemeShinyBrush" Color="{StaticResource ThemeShinyColor}" />
                        <SolidColorBrush x:Key="ThemeShinyGoldBrush" Color="{StaticResource ThemeShinyGoldColor}" />

                        <SolidColorBrush x:Key="ThemeOverlayScrimBrush" Color="{StaticResource ThemeOverlayScrim}" />
                        <SolidColorBrush x:Key="ThemeOverlayForegroundBrush" Color="{StaticResource ThemeOverlayForeground}" />

                        <!-- Gradients -->
                        <LinearGradientBrush x:Key="ThemeAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#4B4B4B" Offset="0" />
                            <GradientStop Color="#707070" Offset="1" />
                        </LinearGradientBrush>

                        <LinearGradientBrush x:Key="ThemeCardGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#F5F5F5" Offset="1" />
                        </LinearGradientBrush>

                        <LinearGradientBrush x:Key="ThemeHeaderGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#4B4B4B20" Offset="0" />
                            <GradientStop Color="#70707010" Offset="1" />
                        </LinearGradientBrush>

                        <!-- Box Shadow Effects - lighter, since shadows read differently on light surfaces -->
                        <BoxShadows x:Key="ThemeShadowSmall">0 1 3 0 #00000020</BoxShadows>
                        <BoxShadows x:Key="ThemeShadowMedium">0 4 12 0 #00000025</BoxShadows>
                        <BoxShadows x:Key="ThemeShadowLarge">0 8 24 0 #00000030</BoxShadows>
                        <BoxShadows x:Key="ThemeGlowAccent">0 0 16 0 #4B4B4B28</BoxShadows>
                        <BoxShadows x:Key="ThemeGlowSuccess">0 0 16 0 #1A7F3730</BoxShadows>
                        <BoxShadows x:Key="ThemeGlowError">0 0 16 0 #CF222E30</BoxShadows>
                    </ResourceDictionary>

                    <!-- ═══════════════════════ HighContrast ═══════════════════════ -->
                    <ResourceDictionary x:Key="{x:Static services:AppThemeVariants.HighContrast}">
                        <!-- Base Colors: pure black surfaces, bright white text/borders -->
                        <Color x:Key="ThemeBackgroundDeep">#000000</Color>
                        <Color x:Key="ThemeBackgroundBase">#000000</Color>
                        <Color x:Key="ThemeBackgroundCard">#000000</Color>
                        <Color x:Key="ThemeBackgroundElevated">#1A1A1A</Color>
                        <Color x:Key="ThemeBackgroundHover">#333333</Color>

                        <!-- Border Colors -->
                        <Color x:Key="ThemeBorderDefault">#FFFFFF</Color>
                        <Color x:Key="ThemeBorderMuted">#AAAAAA</Color>

                        <!-- Native control surfaces -->
                        <Color x:Key="ThemeControlBackground">#000000</Color>
                        <Color x:Key="ThemeControlBackgroundHover">#1A1A1A</Color>
                        <Color x:Key="ThemeControlBackgroundPressed">#333333</Color>
                        <Color x:Key="ThemeControlBorder">#FFFFFF</Color>
                        <Color x:Key="ThemeControlBorderHover">#FFFFFF</Color>
                        <Color x:Key="ThemeControlBorderFocus">#FF4500</Color>
                        <Color x:Key="ThemeControlFocusGlow">#FF450066</Color>
                        <Color x:Key="ThemeControlPopup">#000000</Color>
                        <Color x:Key="ThemeControlPopupHover">#333333</Color>
                        <Color x:Key="ThemeControlPopupSelected">#5A1A00</Color>
                        <Color x:Key="ThemeControlDisabled">#1A1A1A</Color>
                        <Color x:Key="ThemeControlDisabledText">#CCCCCC</Color>

                        <!-- Text Colors (all >15:1 on black) -->
                        <Color x:Key="ThemeTextPrimary">#FFFFFF</Color>
                        <Color x:Key="ThemeTextSecondary">#E0E0E0</Color>
                        <Color x:Key="ThemeTextMuted">#CCCCCC</Color>

                        <!-- Accent Colors - brightened for maximum legibility on black -->
                        <Color x:Key="ThemeAccentPrimary">#FF4500</Color>
                        <Color x:Key="ThemeAccentSecondary">#FF0000</Color>
                        <Color x:Key="ThemeAccentGlow">#FF450066</Color>

                        <!-- Semantic Colors -->
                        <Color x:Key="ThemeSuccessColor">#00FF66</Color>
                        <Color x:Key="ThemeSuccessGlow">#00FF6650</Color>
                        <Color x:Key="ThemeErrorColor">#FF5C4D</Color>
                        <Color x:Key="ThemeErrorGlow">#FF5C4D50</Color>
                        <Color x:Key="ThemeWarningColor">#FFD400</Color>
                        <Color x:Key="ThemeWarningGlow">#FFD40050</Color>
                        <Color x:Key="ThemeShinyColor">#FF4500</Color>
                        <Color x:Key="ThemeShinyGoldColor">#FFFF00</Color>

                        <Color x:Key="ThemeOverlayScrim">#CC000000</Color>
                        <Color x:Key="ThemeOverlayForeground">#FFFFFF</Color>

                        <!-- Brushes -->
                        <SolidColorBrush x:Key="ThemeBackgroundDeepBrush" Color="{StaticResource ThemeBackgroundDeep}" />
                        <SolidColorBrush x:Key="ThemeBackgroundBaseBrush" Color="{StaticResource ThemeBackgroundBase}" />
                        <SolidColorBrush x:Key="ThemeBackgroundCardBrush" Color="{StaticResource ThemeBackgroundCard}" />
                        <SolidColorBrush x:Key="ThemeBackgroundElevatedBrush" Color="{StaticResource ThemeBackgroundElevated}" />
                        <SolidColorBrush x:Key="ThemeBackgroundHoverBrush" Color="{StaticResource ThemeBackgroundHover}" />

                        <SolidColorBrush x:Key="ThemeBorderDefaultBrush" Color="{StaticResource ThemeBorderDefault}" />
                        <SolidColorBrush x:Key="ThemeBorderMutedBrush" Color="{StaticResource ThemeBorderMuted}" />

                        <SolidColorBrush x:Key="ThemeControlBackgroundBrush" Color="{StaticResource ThemeControlBackground}" />
                        <SolidColorBrush x:Key="ThemeControlBackgroundHoverBrush" Color="{StaticResource ThemeControlBackgroundHover}" />
                        <SolidColorBrush x:Key="ThemeControlBackgroundPressedBrush" Color="{StaticResource ThemeControlBackgroundPressed}" />
                        <SolidColorBrush x:Key="ThemeControlBorderBrush" Color="{StaticResource ThemeControlBorder}" />
                        <SolidColorBrush x:Key="ThemeControlBorderHoverBrush" Color="{StaticResource ThemeControlBorderHover}" />
                        <SolidColorBrush x:Key="ThemeControlBorderFocusBrush" Color="{StaticResource ThemeControlBorderFocus}" />
                        <SolidColorBrush x:Key="ThemeControlFocusGlowBrush" Color="{StaticResource ThemeControlFocusGlow}" />
                        <SolidColorBrush x:Key="ThemeControlPopupBrush" Color="{StaticResource ThemeControlPopup}" />
                        <SolidColorBrush x:Key="ThemeControlPopupHoverBrush" Color="{StaticResource ThemeControlPopupHover}" />
                        <SolidColorBrush x:Key="ThemeControlPopupSelectedBrush" Color="{StaticResource ThemeControlPopupSelected}" />
                        <SolidColorBrush x:Key="ThemeControlDisabledBrush" Color="{StaticResource ThemeControlDisabled}" />
                        <SolidColorBrush x:Key="ThemeControlDisabledTextBrush" Color="{StaticResource ThemeControlDisabledText}" />

                        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource ThemeTextPrimary}" />
                        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="{StaticResource ThemeTextSecondary}" />
                        <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="{StaticResource ThemeTextMuted}" />

                        <SolidColorBrush x:Key="ThemeAccentPrimaryBrush" Color="{StaticResource ThemeAccentPrimary}" />
                        <SolidColorBrush x:Key="ThemeAccentSecondaryBrush" Color="{StaticResource ThemeAccentSecondary}" />
                        <SolidColorBrush x:Key="ThemeAccentGlowBrush" Color="{StaticResource ThemeAccentGlow}" />

                        <SolidColorBrush x:Key="ThemeSuccessBrush" Color="{StaticResource ThemeSuccessColor}" />
                        <SolidColorBrush x:Key="ThemeSuccessGlowBrush" Color="{StaticResource ThemeSuccessGlow}" />
                        <SolidColorBrush x:Key="ThemeErrorBrush" Color="{StaticResource ThemeErrorColor}" />
                        <SolidColorBrush x:Key="ThemeErrorGlowBrush" Color="{StaticResource ThemeErrorGlow}" />
                        <SolidColorBrush x:Key="ThemeWarningBrush" Color="{StaticResource ThemeWarningColor}" />
                        <SolidColorBrush x:Key="ThemeWarningGlowBrush" Color="{StaticResource ThemeWarningGlow}" />
                        <SolidColorBrush x:Key="ThemeShinyBrush" Color="{StaticResource ThemeShinyColor}" />
                        <SolidColorBrush x:Key="ThemeShinyGoldBrush" Color="{StaticResource ThemeShinyGoldColor}" />

                        <SolidColorBrush x:Key="ThemeOverlayScrimBrush" Color="{StaticResource ThemeOverlayScrim}" />
                        <SolidColorBrush x:Key="ThemeOverlayForegroundBrush" Color="{StaticResource ThemeOverlayForeground}" />

                        <!-- Gradients - flattened to solid-feeling gradients; HC favors flat, unambiguous fills -->
                        <LinearGradientBrush x:Key="ThemeAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#FF4500" Offset="0" />
                            <GradientStop Color="#FF6A33" Offset="1" />
                        </LinearGradientBrush>

                        <LinearGradientBrush x:Key="ThemeCardGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#000000" Offset="0" />
                            <GradientStop Color="#000000" Offset="1" />
                        </LinearGradientBrush>

                        <LinearGradientBrush x:Key="ThemeHeaderGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#FF450030" Offset="0" />
                            <GradientStop Color="#FF6A3320" Offset="1" />
                        </LinearGradientBrush>

                        <!-- Box Shadow Effects -->
                        <BoxShadows x:Key="ThemeShadowSmall">0 1 3 0 #FFFFFF30</BoxShadows>
                        <BoxShadows x:Key="ThemeShadowMedium">0 4 12 0 #FFFFFF40</BoxShadows>
                        <BoxShadows x:Key="ThemeShadowLarge">0 8 24 0 #FFFFFF50</BoxShadows>
                        <BoxShadows x:Key="ThemeGlowAccent">0 0 16 0 #FF450066</BoxShadows>
                        <BoxShadows x:Key="ThemeGlowSuccess">0 0 16 0 #00FF6650</BoxShadows>
                        <BoxShadows x:Key="ThemeGlowError">0 0 16 0 #FF5C4D50</BoxShadows>
                    </ResourceDictionary>

                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Style.Resources>
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Card Style - Elevated container with subtle depth
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiDensityCardRadius}" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityCardPadding}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ThemeShadowSmall}" />
    </Style>

    <Style Selector="Border.card-elevated">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiDensityCardRadius}" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityCardPadding}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ThemeShadowMedium}" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Global Button Overrides
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Button">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="Button:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Slot Button - Box slot with hover effects
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Button.slot">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate x:DataType="models:SlotData">
                <!-- Root MUST stay hit-test-visible with a non-null fill (Transparent counts) so a
                     pointer press/release anywhere in the slot resolves to this Button and its Click
                     fires. A templated Button has no independent hittable surface: if the template
                     root is IsHitTestVisible="False" the Button's entire visual subtree is excluded
                     from hit-testing and every click (and drop) dies. Drop targeting still works —
                     Avalonia walks UP from the hit element to the nearest DragDrop.AllowDrop, which
                     is this Button (see BoxViewer.axaml); the sprite content Panel is kept
                     IsHitTestVisible="False" only so hits resolve here rather than to the Image. -->
                <Panel Background="Transparent">
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <!-- Illegal Indicator - positioned inside the border with 2px inset -->
                    <Path Data="M 6,0 L 12,11 L 0,11 Z M 6.5,9.5 H 5.5 V 8.5 H 6.5 V 9.5 Z M 6.5,7.5 H 5.5 V 3.5 H 6.5 V 7.5 Z"
                          Fill="{DynamicResource ThemeShinyBrush}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          IsVisible="{Binding !IsLegal}"
                          Margin="0,2,2,0"
                          Width="12" Height="11"/>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.slot:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <!-- Selected State - use the neutral appearance accent -->
    <Style Selector="Button.slot.selected">
        <Setter Property="Background" Value="{StaticResource PkhexNeutralAccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="ZIndex" Value="10" />
    </Style>

    <!-- Focus State - use the neutral appearance accent and keep focus quiet -->
    <Style Selector="Button.slot:focus">
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="ZIndex" Value="10" />
    </Style>

    <!-- Deep Focus Override -->
    <Style Selector="Button.slot:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <Style Selector="TextBlock.slot-number">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>

    <Style Selector="Border.slot-label-surface">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
        <Setter Property="Opacity" Value="0.9" />
        <Setter Property="Padding" Value="3,2" />
    </Style>

    <Style Selector="TextBlock.slot-label">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Accent Button - Primary action button with gradient
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Button.accent-gradient">
        <Setter Property="Background" Value="{StaticResource PkhexNeutralAccentPressedBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiDensityCardRadius}" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityPrimaryButtonPadding}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Badge Styles - Status indicators
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Border.badge-success">
        <Setter Property="Background" Value="{DynamicResource ThemeSuccessBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiDensityBadgeRadius}" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityBadgePadding}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ThemeGlowSuccess}" />
    </Style>

    <Style Selector="Border.badge-error">
        <Setter Property="Background" Value="{DynamicResource ThemeErrorBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiDensityBadgeRadius}" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityBadgePadding}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ThemeGlowError}" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Header Style - Section headers with gradient accent
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Border.header-accent">
        <Setter Property="Background" Value="{DynamicResource ThemeHeaderGradient}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityHeaderPadding}" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Empty Slot Pattern - Subtle diagonal stripes
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Border.empty-slot">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Section Card - For form sections (replaces SystemControlBackgroundChromeMediumLowBrush)
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Border.section-card">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiDensitySectionRadius}" />
        <Setter Property="Padding" Value="{DynamicResource UiDensitySectionPadding}" />
    </Style>

    <!-- Reference editor sections stay flat and divide by rhythm rather than stacking rounded
         cards. This keeps the high-frequency Pokémon form scannable and returns width/height to
         the controls while the broader save-editor surfaces retain section-card for larger tools. -->
    <Style Selector="Border.editor-section">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,0,0,8" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Save workspace pages use the same compact header and flat section language as the
         Pokémon reference editor. Actions stay visible while long forms scroll. -->
    <Style Selector="Grid.save-editor-header">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="DockPanel.save-editor-header">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Inventory pouch navigation is a generated native TabItem strip, styled consistently with
         the editor tabs without replacing Avalonia's control template. -->
    <Style Selector="TabControl.pouch-tabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TabControl.pouch-tabs /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TabControl.pouch-tabs /template/ ItemsPresenter#PART_ItemsPresenter &gt; WrapPanel">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
    </Style>

    <Style Selector="TabControl.pouch-tabs TabItem">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TabControl.pouch-tabs TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="TabControl.pouch-tabs TabItem:selected">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TabControl.pouch-tabs TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Background" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="Height" Value="2" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Full-width inventory tables use a calm native grid with compact, centered cells. -->
    <Style Selector="DataGrid.save-grid">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="DataGrid.save-grid DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityDataGridCellPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="DataGrid.save-grid DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityDataGridCellPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="DataGrid.save-grid DataGridRow">
        <Setter Property="MinHeight" Value="{DynamicResource UiDensityDataGridRowHeight}" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         View Container - Main background for views (replaces SystemControlBackgroundAltHighBrush)
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Border.view-container">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBaseBrush}" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityViewPadding}" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Overlay Scrim - Full-pane dim veil behind loading/searching spinners
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Border.overlay-scrim">
        <Setter Property="Background" Value="{DynamicResource ThemeOverlayScrimBrush}" />
    </Style>

    <Style Selector="Grid.overlay-scrim">
        <Setter Property="Background" Value="{DynamicResource ThemeOverlayScrimBrush}" />
    </Style>

    <!-- Shared view rhythm. Views opt in at their outer content stack and retain local spacing
         only where the layout is intentionally denser than the page rhythm. -->
    <Style Selector="StackPanel.view-stack">
        <Setter Property="Spacing" Value="{DynamicResource UiDensityViewStackSpacing}" />
    </Style>

    <Style Selector="TextBlock.overlay-text">
        <Setter Property="Foreground" Value="{DynamicResource ThemeOverlayForegroundBrush}" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Global Button Transitions - Smooth hover for all buttons
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Button">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Accent Button - Styled primary action button
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{StaticResource PkhexNeutralAccentPressedBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiDensityCardRadius}" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityPrimaryButtonPadding}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.accent:pointerover">
        <Setter Property="Background" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Tab Item Animations - Smooth selection transitions
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="TabItem">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <!-- Pokémon editor section strip: compact, horizontal tabs with one quiet selected rule. -->
    <Style Selector="TabControl.editor-tabs TabItem.editor-tab">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityEditorTabPadding}" />
        <Setter Property="Margin" Value="{DynamicResource UiDensityEditorTabMargin}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <!-- Fluent already renders the selected pipe. Do not add a second item border. -->
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TabControl.editor-tabs TabItem.editor-tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="TabControl.editor-tabs TabItem.editor-tab:selected">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TabControl.editor-tabs TabItem.editor-tab:focus-visible">
        <Setter Property="Background" Value="{DynamicResource ThemeControlFocusGlowBrush}" />
    </Style>

    <Style Selector="TabControl.editor-tabs TabItem.editor-tab:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Background" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="Height" Value="2" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <Style Selector="TabControl.editor-tabs TabItem.editor-tab:focus-visible /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Background" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <Style Selector="TabControl.editor-tabs /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TabControl.editor-tabs /template/ ItemsPresenter#PART_ItemsPresenter &gt; WrapPanel">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
    </Style>

    <Style Selector="TabControl.editor-tabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.entity-summary">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Main save workspace tabs: compact enough to keep all destinations discoverable, with a
         quiet neutral baseline that is visually distinct from the editor's vertical section spine. -->
    <Style Selector="TabControl.workspace-tabs TabItem.workspace-tab">
        <Setter Property="Padding" Value="{DynamicResource UiDensityWorkspaceTabPadding}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TabControl.workspace-tabs TabItem.workspace-tab:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
    </Style>

    <Style Selector="TabControl.workspace-tabs TabItem.workspace-tab:selected">
        <Setter Property="Foreground" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TabControl.workspace-tabs TabItem.workspace-tab:focus-visible">
        <Setter Property="Background" Value="{DynamicResource ThemeControlFocusGlowBrush}" />
    </Style>

    <Style Selector="TabControl.workspace-tabs TabItem.workspace-tab:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Background" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="Height" Value="2" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <Style Selector="TabControl.workspace-tabs TabItem.workspace-tab:focus-visible /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Background" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <Style Selector="TabControl.workspace-tabs /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TabControl.workspace-tabs /template/ ItemsPresenter#PART_ItemsPresenter &gt; WrapPanel">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
    </Style>

    <Style Selector="TabControl.workspace-tabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Entity status actions share one 26px centerline so Legal/Illegal and Shiny never drift
         relative to the Pokémon title. -->
    <Style Selector="Button.entity-status-action">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.entity-status-action:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.entity-shiny-action">
        <Setter Property="Width" Value="26" />
    </Style>

    <Style Selector="Border.entity-status-badge">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         ComboBox Transitions
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="ComboBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         COMPONENT STANDARDS - NumericUpDown
         These styles establish a consistent look for numeric inputs across all editors.
         Use these classes:
         - NumericUpDown.compact    : Hide spinners, centered text, good for inline use (tables, grids)
         - NumericUpDown.form-field : Standard form field with proper sizing
         - NumericUpDown.condensed  : Smaller variant for tight spaces (legacy, use .compact instead)
         ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Base NumericUpDown transitions and hover -->
    <Style Selector="NumericUpDown">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="NumericUpDown:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <!-- Compact: Hides spinners, ideal for DataGrid cells and inline editing -->
    <Style Selector="NumericUpDown.compact">
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="MinWidth" Value="{DynamicResource UiDensityInlineControlMinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiDensityInlineControlHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Stats table override: the main editor deliberately remains usable in a 360px pane. -->
    <Style Selector="NumericUpDown.stats-number">
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Form Field: Standard sizing for form layouts -->
    <Style Selector="NumericUpDown.form-field">
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="MinHeight" Value="{DynamicResource UiDensityControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityFormFieldPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Legacy condensed style - use .compact instead -->
    <Style Selector="NumericUpDown.condensed">
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         COMPONENT STANDARDS - DataGrid
         Standardized DataGrid appearance for list/table views.
         ═══════════════════════════════════════════════════════════════════════════ -->

    <Style Selector="DataGrid">
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="MinHeight" Value="{DynamicResource UiDensityDataGridRowHeight}" />
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="{DynamicResource UiDensityDataGridCellPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         COMPONENT STANDARDS - ComboBox in DataGrid
         Transparent backgrounds for inline editing feel.
         ═══════════════════════════════════════════════════════════════════════════ -->

    <Style Selector="DataGrid ComboBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityDataGridEditPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiDensityDataGridEditHeight}" />
    </Style>

    <Style Selector="DataGrid NumericUpDown">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityDataGridEditPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiDensityDataGridEditHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         COMPONENT STANDARDS - CheckBox in compact layouts
         ═══════════════════════════════════════════════════════════════════════════ -->

    <Style Selector="CheckBox.compact">
        <Setter Property="Padding" Value="{DynamicResource UiDensityCompactCheckBoxPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource UiDensityCompactCheckBoxHeight}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         RIBBON ITEM - Standard ribbon item card for RibbonEditor
         ═══════════════════════════════════════════════════════════════════════════ -->

    <Style Selector="Border.ribbon-item">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="140" />
        <Setter Property="Height" Value="100" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <Style Selector="Border.ribbon-item:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         TextBox Transitions
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="TextBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Section Header Label - For labeling sections
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="TextBlock.section-header">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="{DynamicResource UiDensitySectionHeaderMargin}" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         View Title - Main view headers
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="TextBlock.view-title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <!-- ─────────────────────────────────────────────────────────────────────────
         Pane Splitter - Draggable divider between a sidebar rail and its content.
         Shared convention for resizable filter rails (database views, etc.).
         ───────────────────────────────────────────────────────────────────────── -->
    <Style Selector="GridSplitter.pane-splitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <!-- Thin centred grip line, rendered via a child border in the template -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <Border Width="2" CornerRadius="1"
                            HorizontalAlignment="Center" VerticalAlignment="Stretch"
                            Margin="0,8"
                            Background="{DynamicResource ThemeBorderMutedBrush}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="GridSplitter.pane-splitter:pointerover /template/ Border > Border">
        <Setter Property="Background" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════════
         FRONTEND REFACTOR SHELL
         These primitives are the visual contract for the task-aware desktop composition. They
         deliberately separate application chrome, working surfaces, and recessed controls so the
         main window no longer reads as one continuous WinForms-style card.
         ═══════════════════════════════════════════════════════════════════════════ -->

    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundDeepBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>

    <Style Selector="Border.app-header">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityHeaderPadding}" />
    </Style>

    <Style Selector="Border.brand-mark">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="TextBlock.app-brand-name">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.app-brand-subtitle">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>

    <Style Selector="Border.save-context">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TextBlock.save-context-name">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.save-context-status">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>

    <Style Selector="Button.header-tool-button">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.header-tool-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <Style Selector="Button PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>

    <Style Selector="Button:pointerover PathIcon">
        <Setter Property="Foreground" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <Style Selector="Border.welcome-surface">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Margin" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="48" />
    </Style>

    <Style Selector="StackPanel.welcome-stack">
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style Selector="Border.welcome-icon">
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="76" />
        <Setter Property="Padding" Value="9" />
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>

    <Style Selector="TextBlock.welcome-title">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.welcome-subtitle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>

    <Style Selector="Border.workspace-rail">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="TextBlock.rail-eyebrow">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="1.2" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>

    <Style Selector="ToggleButton.workspace-nav-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>

    <Style Selector="ToggleButton.workspace-nav-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="ToggleButton.workspace-nav-item:checked">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="ToggleButton.workspace-nav-item:checked:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Fluent's ToggleButton theme paints checked state on its template presenter. Override that
         presenter as well as the control property so the rail remains outline-only in the actual
         compositor, including the checked+pointerover state. -->
    <Style Selector="ToggleButton.workspace-nav-item:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ToggleButton.workspace-nav-item:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ToggleButton.workspace-nav-item:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <Style Selector="Border.workspace-nav-icon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.workspace-nav-icon &gt; PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource PkhexNeutralIconBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ToggleButton.workspace-nav-item:pointerover Border.workspace-nav-icon &gt; PathIcon">
        <Setter Property="Foreground" Value="{StaticResource PkhexNeutralIconBrush}" />
    </Style>

    <Style Selector="ToggleButton.workspace-nav-item:checked Border.workspace-nav-icon &gt; PathIcon">
        <Setter Property="Foreground" Value="{StaticResource PkhexNeutralIconBrush}" />
    </Style>

    <Style Selector="TextBlock.workspace-nav-title">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.workspace-nav-description">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>

    <Style Selector="Border.reports-surface">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBaseBrush}" />
        <Setter Property="Padding" Value="{DynamicResource UiDensityViewPadding}" />
    </Style>

    <Style Selector="StackPanel.reports-layout">
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style Selector="StackPanel.reports-header">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Border.reports-rule">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ThemeBorderMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.view-subtitle">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>

    <Style Selector="Button.report-tool-card">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.report-tool-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentHoverBrush}" />
    </Style>

    <Style Selector="Button.report-tool-card:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Border.report-tool-icon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.report-tool-icon &gt; Path">
        <Setter Property="Stroke" Value="{StaticResource PkhexNeutralIconBrush}" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.report-tool-card:pointerover Border.report-tool-icon &gt; Path">
        <Setter Property="Stroke" Value="{StaticResource PkhexNeutralIconBrush}" />
    </Style>

    <Style Selector="PathIcon.report-tool-arrow">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.report-tool-title">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.report-tool-description">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>

    <!-- Dense selectable rows used by auxiliary record/gift lists. The single bottom rule keeps
         large histories scannable without stacking rounded native button cards. -->
    <Style Selector="Button.auxiliary-list-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.auxiliary-list-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
    </Style>

    <Style Selector="Button.auxiliary-list-item /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button.auxiliary-list-item:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
    </Style>

    <Style Selector="Border.party-strip">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style Selector="StackPanel.party-strip-label">
        <Setter Property="Width" Value="62" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.party-strip-label TextBlock:first-child">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="StackPanel.party-strip-label TextBlock:last-child">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>

    <Style Selector="Border.party-strip-slot">
        <Setter Property="Height" Value="54" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.party-strip-empty">
        <Setter Property="Margin" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="TextBlock.party-strip-name">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
        <Setter Property="Margin" Value="3,0,3,2" />
    </Style>

    <Style Selector="Border.launcher-overlay">
        <Setter Property="Background" Value="{DynamicResource ThemeOverlayScrimBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ZIndex" Value="100" />
    </Style>

    <Style Selector="Border.launcher-panel">
        <Setter Property="Width" Value="520" />
        <Setter Property="MaxWidth" Value="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,56,0,0" />
        <Setter Property="BoxShadow" Value="{DynamicResource ThemeShadowLarge}" />
    </Style>

    <Style Selector="Border.launcher-search-box">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <Style Selector="Border.launcher-search-box Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stroke" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>

    <Style Selector="TextBox.launcher-search-input">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="TextBox.launcher-search-input:focus">
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.launcher-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.launcher-item:pointerover">
        <Setter Property="Background" Value="{StaticResource PkhexNeutralAccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PkhexNeutralAccentBrush}" />
    </Style>

    <Style Selector="Border.launcher-item-icon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.launcher-item-icon &gt; Path">
        <Setter Property="Stroke" Value="{StaticResource PkhexNeutralIconBrush}" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.launcher-item:pointerover Border.launcher-item-icon &gt; Path">
        <Setter Property="Stroke" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.launcher-item-title">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.launcher-item-description">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
    </Style>

    <Style Selector="Button.icon-button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style Selector="Button.icon-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

</Styles>
